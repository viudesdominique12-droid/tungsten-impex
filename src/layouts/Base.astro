---
import '../styles/tokens.css';
import site from '../data/site.json';
import BarreAppel from '../components/BarreAppel.astro';

const { title, description, flow = 'out' } = Astro.props;
const c = site.company;
const here = Astro.url.pathname;
const cur = (h) => (here === h ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />

  {/* §2 — auto-hébergée et préchargée. Sans la variable, l'axe wdth disparaît
      et toute la hiérarchie s'effondre en Helvetica. */}
  <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />

  <meta name="theme-color" content={flow === 'in' ? '#e7ecf5' : '#f2f5f9'} />
</head>

<body data-flow={flow}>
  <a class="skip" href="#main">Skip to content</a>

  {/* Le bandeau bleu et l'en-tête ne font qu'un bloc, et ce bloc est collant.
      Le bleu tient le bord supérieur de la page à la place du filet qu'on a
      retiré : effacer un trait sans donner à sa fonction un remplaçant, c'est
      casser quelque chose, pas l'épurer. Les points médians ont sauté aussi —
      une liste de références séparées par des points est une tournure de
      gabarit ; l'année de fondation descend au pied, où vit un colophon. */}
  <div class="top">
    <div class="util" data-ground="blue">
      <div class="shell util__in t-label">
        <span>{c.address.city}, {c.address.country}</span>
        <a href={`tel:${c.phoneHref}`}>{c.phone}</a>
      </div>
    </div>

  {/* §4 — transparent, posé sur le fond de la page. Filet au scroll, pas d'ombre. */}
  <header class="hdr" id="hdr">
    <div class="shell hdr__in">
      <a class="mark" href="/">
        <strong>Tungsten</strong>
        <span class="t-label t-quiet">Import Export</span>
      </a>
      <button class="menu" id="nav-open" type="button" aria-expanded="false" aria-controls="nav">
        <i aria-hidden="true"></i> Menu
      </button>
    </div>
    </header>
  </div>

  <div class="nav" id="nav" data-open="false" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="shell nav__bar">
      <a class="mark" href="/"><strong>Tungsten</strong><span class="t-label t-quiet">Import Export</span></a>
      <button class="nav__x" id="nav-close" type="button" aria-label="Close menu">&times;</button>
    </div>
    <div class="nav__body">
      <div class="shell nav__grid">
        <nav class="nav__main" aria-label="Main">
          <a href="/about/" aria-current={cur('/about/')}>About us</a>
          <a href="/training/" aria-current={cur('/training/')}>Book to train with us</a>
          <a href="/contact/" aria-current={cur('/contact/')}>Contact us</a>
        </nav>

        <div class="nav__grp">
          <a class="nav__head" href="/#exports"><b>Exports</b><span class="t-note t-quiet">{site.exports.length} products</span></a>
          <ul>
            {site.exports.map((p) => (
              <li><a href={`/export/${p.slug}/`} aria-current={cur(`/export/${p.slug}/`)}>{p.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="nav__grp">
          <a class="nav__head" href="/#imports"><b>Imports</b><span class="t-note t-quiet">{site.imports.length} categories</span></a>
          <ul>
            {site.imports.map((p) => (
              <li><a href={`/import/${p.slug}/`} aria-current={cur(`/import/${p.slug}/`)}>{p.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="shell nav__foot t-label t-quiet">
        <a href={`tel:${c.phoneHref}`}>{c.phone}</a>
        <a href={`mailto:${c.email}`}>{c.email}</a>
        <span>{c.address.line1}, {c.address.city}</span>
      </div>
    </div>
  </div>

  <main id="main"><slot /></main>

  {/* §4 — le pied de page est un bandeau pleine largeur sur l'encre. */}
  <footer class="ftr" data-ground="ink">
    <div class="shell ftr__in">
      <div>
        <p class="ftr__name">{c.name}</p>
        <p class="t-note t-quiet ftr__est">Established {c.founded} &middot; EFDA licensed</p>
        <p class="t-note t-quiet ftr__addr">
          {c.address.line1}<br />{c.address.line2}<br />{c.address.city}, {c.address.country}
        </p>
      </div>
      <div>
        <p class="t-label t-quiet ftr__h">Exports</p>
        <ul>{site.exports.map((p) => <li><a href={`/export/${p.slug}/`}>{p.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="t-label t-quiet ftr__h">Imports</p>
        <ul>{site.imports.map((p) => <li><a href={`/import/${p.slug}/`}>{p.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="t-label t-quiet ftr__h">Company</p>
        <ul>
          <li><a href="/about/">About us</a></li>
          <li><a href="/training/">Training</a></li>
          <li><a href="/contact/">Contact us</a></li>
        </ul>
      </div>
    </div>
    <div class="shell ftr__end t-note t-quiet">
      <span>&copy; {new Date().getFullYear()} {c.name}</span>
    </div>
  </footer>

  <BarreAppel />

  <script>
    const nav = document.getElementById('nav');
    const openBtn = document.getElementById('nav-open');
    const shutBtn = document.getElementById('nav-close');
    let last = null;
    const reachable = () =>
      [...nav.querySelectorAll('a[href], button')].filter((el) => el.offsetParent !== null);

    function open() {
      last = document.activeElement;
      nav.dataset.open = 'true';
      nav.removeAttribute('aria-hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.dataset.nav = 'open';
      setTimeout(() => { const f = reachable(); if (f.length) f[0].focus(); }, 280);
    }
    function shut() {
      nav.dataset.open = 'false';
      nav.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      delete document.body.dataset.nav;
      if (last) last.focus();
    }
    openBtn.addEventListener('click', open);
    shutBtn.addEventListener('click', shut);
    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true') return;
      if (e.key === 'Escape') return shut();
      if (e.key !== 'Tab') return;
      const f = reachable(); if (!f.length) return;
      const a = f[0], z = f[f.length - 1];
      if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
      else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
    });

  </script>

  <style is:global>
    /* --------------------------------------------- bandeau utilitaire §4 - */
    .util__in { display: flex; align-items: center; justify-content: space-between;
                gap: 16px; min-height: 32px; }
    .util__in a { text-decoration: none; }
    .util__in a:hover { text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 560px) { .util__in span { display: none; }
      .util__in { justify-content: flex-end; } }

    /* -------------------------------------------------------- en-tête §4 - */
    .top { position: sticky; top: 0; z-index: 60; }
    .hdr { background: var(--bg); }
    .hdr__in { display: flex; align-items: center; justify-content: space-between;
               gap: 20px; min-height: 66px; }

    .mark { display: inline-flex; flex-direction: column; gap: 1px;
            text-decoration: none; line-height: 1.05; }
    .mark strong { font-stretch: var(--wd-display); font-weight: var(--w-display);
                   font-size: var(--t-h3); letter-spacing: var(--tr-display); }
    .mark span { font-size: var(--t-label); }

    .menu { display: inline-flex; align-items: center; gap: 9px; cursor: pointer;
            font-family: inherit; font-stretch: var(--wd-label); font-weight: var(--w-label);
            font-size: var(--t-label); letter-spacing: var(--tr-label);
            text-transform: uppercase; background: none; border: 0; color: var(--fg);
            padding: 6px 1px; }
    .menu:hover, .mark:hover { text-decoration: underline; text-underline-offset: 5px;
                          text-decoration-thickness: 1px; }
    .menu i { display: block; width: 16px; height: 1.5px; background: currentColor;
              position: relative; }
    .menu i::before, .menu i::after { content: ''; position: absolute; left: 0;
      width: 16px; height: 1.5px; background: currentColor; }
    .menu i::before { top: -5px; } .menu i::after { top: 5px; }

    /* ------------------------------------------------------ menu pop-up -- */
    .nav { position: fixed; inset: 0; z-index: 200; background: var(--bg); color: var(--fg);
           display: grid; grid-template-rows: auto 1fr;
           opacity: 0; visibility: hidden;
           transition: opacity .25s var(--ease-out), visibility .25s; }
    .nav[data-open='true'] { opacity: 1; visibility: visible; }
    body[data-nav='open'] { overflow: hidden; }
    .nav__bar { display: flex; align-items: center; justify-content: space-between;
                min-height: 66px; }
    .nav__x { width: 36px; height: 36px; border: 0; background: none;
              color: var(--fg); cursor: pointer; display: grid; place-items: center;
              font-size: 22px; line-height: 1; }
    .nav__x:hover { color: var(--muted); }
    .nav__body { overflow-y: auto; padding-block: var(--s-block); }
    .nav__grid { display: grid; gap: 28px; }
    @media (min-width: 900px) { .nav__grid { grid-template-columns: 1.1fr 1fr 1fr; gap: 24px 44px; } }

    .nav__main { display: grid; align-content: start; gap: 10px; }
    .nav__main a { display: block; text-decoration: none; width: fit-content;
      font-stretch: var(--wd-display); font-weight: var(--w-display);
      font-size: var(--t-h2); line-height: var(--lh-h2); letter-spacing: var(--tr-display); }
    .nav__main a:hover { text-decoration: underline; text-underline-offset: 5px;
                          text-decoration-thickness: 1px; }
    .nav__main a[aria-current='page'] { color: var(--muted); }

    .nav__head { display: grid; gap: 2px; text-decoration: none;
                 margin-bottom: 20px; width: fit-content; }
    .nav__head b { font-stretch: var(--wd-display); font-weight: var(--w-display);
                  font-size: var(--t-h2); letter-spacing: var(--tr-display); }
    .nav__grp ul { list-style: none; margin: 0; padding: 0;
                   display: grid; gap: 8px; }
    .nav__grp li a { display: block; text-decoration: none; width: fit-content;
                     font-size: var(--t-body); }
    .nav__grp li a:hover { text-decoration: underline; text-underline-offset: 5px;
                           text-decoration-thickness: 1px; }
    .nav__grp li a[aria-current='page'] { color: var(--muted); }

    .nav__foot { margin-top: var(--s-block); display: flex; flex-wrap: wrap;
                 gap: 6px 26px; }
    .nav__foot a { text-decoration: none; }

    /* ------------------------------------------------------------ pied -- */
    .ftr { margin-top: 0; }
    .ftr__in { display: grid; gap: var(--s-block) 40px; padding-block: var(--s-section); }
    @media (min-width: 760px) { .ftr__in { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }
    .ftr__name { font-stretch: var(--wd-display); font-weight: var(--w-display);
                 font-size: var(--t-h3); letter-spacing: var(--tr-display);
                 margin: 0 0 10px; }
    .ftr__est { margin: 8px 0 4px; }
    .ftr__addr { margin: 0; line-height: 1.7; }
    .ftr__h { margin: 0 0 12px; }
    .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: var(--t-body); }
    .ftr a { text-decoration: none; }
    .ftr a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .ftr__end { display: flex; flex-wrap: wrap; gap: 6px 22px; justify-content: space-between;
                padding-bottom: 30px; }
    .ftr__end a { text-decoration: none; }
  </style>
</body>
</html>

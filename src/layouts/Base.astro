---
import '../styles/tokens.css';
import site from '../data/site.json';
import BarreAppel from '../components/BarreAppel.astro';
import Rail from '../components/Rail.astro';

import { lien } from '../lib/lien.js';

/* Les quatre fontes sont importees, pas ecrites en dur. Le compilateur rend
   leur adresse finale — empreinte de contenu comprise, et prefixe du
   sous-chemin quand le site n'est pas publie a la racine. Un href="/fonts/..."
   ecrit a la main pointe a cote des la premiere page de projet. */
import fraunces from '../fonts/fraunces-var.woff2?url';
import frauncesItal from '../fonts/fraunces-var-italic.woff2?url';
import instrument from '../fonts/instrument-sans-var.woff2?url';
import mono from '../fonts/plex-mono.woff2?url';

const { title, description, rail = 'TUNGSTEN' } = Astro.props;
const c = site.company;
const here = Astro.url.pathname;
/* La page courante se compare a l'adresse PUBLIEE, pas au chemin nu : sous un
   sous-chemin, `here` vaut /nom-du-depot/about/ et la comparaison brute ne
   trouvait jamais rien — le menu perdait sa marque de page courante. */
const cur = (h) => (here === lien(h) ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />

  {/* Auto-hebergees et prechargees. Sans elles, toute la hierarchie
      s'effondre en Helvetica et il ne reste que la taille pour distinguer un
      titre d'un paragraphe — le defaut exact que cette refonte corrige. */}
  {[fraunces, frauncesItal, instrument, mono].map((f) => (
    <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />
  ))}

  <meta name="theme-color" content="#0A1B3C" />
</head>

<body>
  <a class="skip" href="#main">Skip to content</a>

  {/* Le bandeau utilitaire et l'en-tete ne font qu'un bloc, et ce bloc est
      collant. Il portait le nom `.top`, que trois pages emploient pour leur
      propre bandeau de titre : leur titre heritait du `position: sticky` et
      venait se poser par-dessus le corps de la page. Le chassis porte
      desormais un nom qui n'appartient qu'a lui. */}
  <div class="chapeau">
    <div class="util" data-sol="accent">
      <div class="shell util__in t-label">
        <span>{c.address.city}, {c.address.country}</span>
        <a href={`tel:${c.phoneHref}`}>{c.phone}</a>
      </div>
    </div>

    <header class="hdr" id="hdr">
      <div class="shell hdr__in">
        <a class="mark" href={lien('/')}>
          <strong>Tungsten</strong>
          <span class="t-label t-quiet">Import Export</span>
        </a>
        <button class="menu t-label" id="nav-open" type="button" aria-expanded="false" aria-controls="nav">
          <i aria-hidden="true"></i> Menu
        </button>
      </div>
    </header>
  </div>

  <Rail prefixe={rail} />

  <div class="nav" id="nav" data-open="false" data-sol="nuit" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="shell nav__bar">
      <a class="mark" href={lien('/')}><strong>Tungsten</strong><span class="t-label t-quiet">Import Export</span></a>
      <button class="nav__x" id="nav-close" type="button" aria-label="Close menu">&times;</button>
    </div>
    <div class="nav__body">
      <div class="shell nav__grid">
        <nav class="nav__main" aria-label="Main">
          <a href={lien('/about/')} aria-current={cur('/about/')}>About us</a>
          <a href={lien('/training/')} aria-current={cur('/training/')}>Book to train with us</a>
          <a href={lien('/contact/')} aria-current={cur('/contact/')}>Contact us</a>
        </nav>

        <div class="nav__grp">
          <a class="nav__head" href={lien('/#exports')}><b>Exports</b><span class="t-label t-quiet">{site.exports.length} products</span></a>
          <ul>
            {site.exports.map((p) => (
              <li><a href={lien(`/export/${p.slug}/`)} aria-current={cur(`/export/${p.slug}/`)}>{p.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="nav__grp">
          <a class="nav__head" href={lien('/#imports')}><b>Imports</b><span class="t-label t-quiet">{site.imports.length} categories</span></a>
          <ul>
            {site.imports.map((p) => (
              <li><a href={lien(`/import/${p.slug}/`)} aria-current={cur(`/import/${p.slug}/`)}>{p.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="shell nav__foot t-label t-quiet">
        <a href={`tel:${c.phoneHref}`}>{c.phone}</a>
        <a href={`mailto:${c.email}`}>{c.email}</a>
        <span>{c.address.line1}, {c.address.city}</span>
      </div>
    </div>
  </div>

  <main id="main"><slot /></main>

  <footer class="ftr" data-sol="nuit">
    <div class="shell ftr__in">
      <div>
        <p class="t-label t-quiet code">Tungsten Import Export</p>
        <p class="t-h3 ftr__name">Established {c.founded}</p>
        <p class="t-note t-quiet ftr__addr">
          {c.address.line1}<br />{c.address.line2}<br />{c.address.city}, {c.address.country}
        </p>
      </div>
      <div>
        <p class="t-label t-quiet ftr__h">Exports</p>
        <ul>{site.exports.map((p) => <li><a href={lien(`/export/${p.slug}/`)}>{p.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="t-label t-quiet ftr__h">Imports</p>
        <ul>{site.imports.map((p) => <li><a href={lien(`/import/${p.slug}/`)}>{p.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="t-label t-quiet ftr__h">Company</p>
        <ul>
          <li><a href={lien('/about/')}>About us</a></li>
          <li><a href={lien('/training/')}>Training</a></li>
          <li><a href={lien('/contact/')}>Contact us</a></li>
        </ul>
      </div>
    </div>
    <div class="shell ftr__end t-label t-quiet">
      <span>&copy; {new Date().getFullYear()} {c.name}</span>
      <span>EFDA licensed</span>
    </div>
  </footer>

  <BarreAppel />

  <script>
    const nav = document.getElementById('nav');
    const openBtn = document.getElementById('nav-open');
    const shutBtn = document.getElementById('nav-close');
    let last = null;
    const reachable = () =>
      [...nav.querySelectorAll('a[href], button')].filter((el) => el.offsetParent !== null);

    function open() {
      last = document.activeElement;
      nav.dataset.open = 'true';
      nav.removeAttribute('aria-hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.dataset.nav = 'open';
      setTimeout(() => { const f = reachable(); if (f.length) f[0].focus(); }, 280);
    }
    function shut() {
      nav.dataset.open = 'false';
      nav.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      delete document.body.dataset.nav;
      if (last) last.focus();
    }
    openBtn.addEventListener('click', open);
    shutBtn.addEventListener('click', shut);
    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true') return;
      if (e.key === 'Escape') return shut();
      if (e.key !== 'Tab') return;
      const f = reachable(); if (!f.length) return;
      const a = f[0], z = f[f.length - 1];
      if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
      else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
    });
  </script>

  <style is:global>
    /* --------------------------------------------- bandeau utilitaire ---- */
    .util__in { display: flex; align-items: center; justify-content: space-between;
                gap: 16px; min-height: 34px; }
    .util__in a { text-decoration: none; }
    .util__in a:hover { text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 560px) { .util__in span { display: none; }
      .util__in { justify-content: flex-end; } }

    /* ------------------------------------------------------- en-tete ----- */
    .chapeau { position: sticky; top: 0; z-index: 60; }
    /* L'en-tete n'est pas transparent : il passe au-dessus de sections nuit,
       de rubans en accent et de bandes photo. Un fond opaque, et un filet qui
       le separe de ce qu'il recouvre. */
    .hdr { background: var(--bg); border-bottom: 1px solid rgba(10, 26, 51, .1); }
    .hdr__in { display: flex; align-items: center; justify-content: space-between;
               gap: 20px; min-height: 68px; }

    .mark { display: inline-flex; flex-direction: column; gap: 2px;
            text-decoration: none; line-height: 1.02; }
    .mark strong { font-family: var(--font-display); font-weight: 600;
                   font-size: var(--step-1); letter-spacing: -.012em; }

    .menu { display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
            font-family: var(--font-mono); font-size: var(--label);
            letter-spacing: .12em; text-transform: uppercase;
            background: none; border: 0; color: inherit; padding: 8px 2px; }
    .menu:hover, .mark:hover { text-decoration: underline; text-underline-offset: 5px;
                               text-decoration-thickness: 1px; }
    .menu i { display: block; width: 17px; height: 1.5px; background: currentColor;
              position: relative; }
    .menu i::before, .menu i::after { content: ''; position: absolute; left: 0;
      width: 17px; height: 1.5px; background: currentColor; }
    .menu i::before { top: -5px; } .menu i::after { top: 5px; }

    /* ------------------------------------------------------ menu plein --- */
    .nav { position: fixed; inset: 0; z-index: 200;
           display: grid; grid-template-rows: auto 1fr;
           opacity: 0; visibility: hidden;
           transition: opacity .25s var(--ease-pipette), visibility .25s; }
    .nav[data-open='true'] { opacity: 1; visibility: visible; }
    body[data-nav='open'] { overflow: hidden; }
    .nav__bar { display: flex; align-items: center; justify-content: space-between;
                min-height: 68px; }
    .nav__x { width: 40px; height: 40px; border: 0; background: none;
              color: inherit; cursor: pointer; display: grid; place-items: center;
              font-size: 24px; line-height: 1; }
    .nav__x:hover { color: var(--gris); }
    .nav__body { overflow-y: auto; padding-block: var(--pile); }
    .nav__grid { display: grid; gap: var(--pile); }
    @media (min-width: 900px) { .nav__grid { grid-template-columns: 1.1fr 1fr 1fr; gap: 32px 48px; } }

    .nav__main { display: grid; align-content: start; gap: 10px; }
    .nav__main a { display: block; text-decoration: none; width: fit-content;
      font-family: var(--font-display); font-weight: 520;
      font-size: var(--step-2); line-height: 1.15; letter-spacing: -.01em; }
    .nav__main a:hover { text-decoration: underline; text-underline-offset: 5px;
                          text-decoration-thickness: 1px; }
    .nav__main a[aria-current='page'] { color: var(--gris); }

    .nav__head { display: grid; gap: 6px; text-decoration: none;
                 margin-bottom: 22px; width: fit-content;
                 padding-bottom: 14px; border-bottom: 1px solid var(--filet); }
    .nav__head b { font-family: var(--font-display); font-weight: 560;
                   font-size: var(--step-1); letter-spacing: -.01em; }
    .nav__grp ul { list-style: none; margin: 0; padding: 0;
                   display: grid; gap: 8px; }
    .nav__grp li a { display: block; text-decoration: none; width: fit-content; }
    .nav__grp li a:hover { text-decoration: underline; text-underline-offset: 5px;
                           text-decoration-thickness: 1px; }
    .nav__grp li a[aria-current='page'] { color: var(--gris); }

    .nav__foot { margin-top: var(--pile); display: flex; flex-wrap: wrap;
                 gap: 8px 28px; }
    .nav__foot a { text-decoration: none; }

    /* ----------------------------------------------------------- pied --- */
    .ftr__in { display: grid; gap: var(--pile) 40px;
               padding-block: var(--pad-section-mob) var(--pile); }
    @media (min-width: 760px) { .ftr__in { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
    @media (min-width: 900px) { .ftr__in { padding-block: var(--pad-section) var(--pile); } }
    .ftr__name { margin: 14px 0 12px; }
    .ftr__addr { margin: 0; line-height: 1.7; }
    .ftr__h { margin: 0 0 16px; padding-bottom: 12px;
              border-bottom: 1px solid var(--filet); }
    .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px;
              font-size: var(--step--1); }
    .ftr a { text-decoration: none; }
    .ftr a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .ftr__end { display: flex; flex-wrap: wrap; gap: 8px 24px;
                justify-content: space-between; padding-top: 22px;
                padding-bottom: 34px; border-top: 1px solid var(--filet); }
  </style>
</body>
</html>

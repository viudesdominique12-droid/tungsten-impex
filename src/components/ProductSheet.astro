---
/* La fiche produit, passee au repertoire.

     A  tete sur nuit : fil d'Ariane, code, nom, chapeau
     E  editorial : le chapeau, puis LA PLAQUE
     H  index a filets pour les specifications
     E  editorial deux colonnes pour les textes, sur nuit
     F  appel, puis les autres lignes de la meme direction

   La plaque est decrite dans tokens.css. Une proportion, une largeur, un fond,
   pour les quatorze : c'est le cadre qui fait le catalogue, pas les images.
*/
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import copy from '../data/copy.json';
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos.js';

const { product, siblings } = Astro.props;
const c = copy[product.slug] ?? { lead: '', facts: [], blocks: [], cta: '' };

const flow = product.direction === 'out' ? 'out' : 'in';
const folder = flow === 'out' ? 'export' : 'import';
const label = flow === 'out' ? 'Exports' : 'Imports';
const sens = flow === 'out' ? 'Out of Ethiopia' : 'Into Ethiopia';

const others = siblings.filter((sib) => sib.slug !== product.slug);

const img = photo(product.photo);
/* LA PLAQUE, pour les quatorze, sans exception.

   Deux fiches sur quatorze avaient une bande pleine largeur — celles dont le
   fichier etait assez grand — et les douze autres une photographie posee dans
   la colonne, chacune a sa taille. Cette regle-la etait techniquement juste et
   visuellement fausse : elle faisait dependre la mise en page de la taille du
   fichier, si bien qu'aucune fiche ne ressemblait a une autre.

   La plaque ne demande rien au fichier. Elle a sa proportion, sa largeur et son
   fond ; l'image s'y pose entiere, a sa taille reelle si elle est plus petite.
   Les quatorze fiches se ressemblent enfin, et la bande pleine largeur reste ou
   elle a un sens : sur les photographies de la maison, qui sont documentaires
   et assez grandes pour la remplir.

   La plaque fait 620px de large au plus : c'est ce que la plus petite source
   (447px) supporte sans depasser la limite d'agrandissement du site. */
const jeu = largeurs(img, [400, 620, 900, 1240]);
import { lien } from '../lib/lien.js';
import { largeurs } from '../lib/largeurs.js';
---

<Base title={`${product.name} — Tungsten Import Export`} description={c.lead} rail={label.toUpperCase()}>
  <article>
    <header class="tete section" data-type="A" data-sol="nuit" data-premier data-rail-section={product.name.toUpperCase()}>
      <div class="shell tete__in">
        <div>
          <nav class="crumb t-label t-quiet" aria-label="Breadcrumb">
            <a href={lien('/')}>Tungsten</a>
            <span aria-hidden="true">/</span>
            <a href={lien(`/#${label.toLowerCase()}`)}>{label}</a>
          </nav>
          <h1 class="t-display tete__h">{product.name}</h1>
        </div>
        <p class="t-label t-quiet code tete__sens">{sens}</p>
      </div>
    </header>

    {/* La marchandise D'ABORD, la phrase en regard.

        Cette section etait un editorial : un libelle seul dans une colonne de
        gauche vide, et a droite le chapeau puis la photographie sous lui. Sur
        un ecran de 1440, cela laissait un tiers de la page vide a gauche et
        reléguait la marchandise en bas a droite — sur une fiche produit, c'est
        exactement l'inverse de ce qu'on vient voir. La plaque prend la
        premiere place, la phrase se lit a cote d'elle.

        Au telephone les deux s'empilent, et la phrase passe devant : on lit ce
        qu'est la ligne, puis on la regarde. */}
    <section class="section intro" data-type="E" data-rail-section="THE LINE">
      <div class="shell intro__in">
        {img && (
          <figure class="plaque intro__img">
            <Picture src={img} alt={product.name} formats={['avif']} fallbackFormat="webp"
                     widths={jeu}
                     sizes="(max-width: 900px) 92vw, 620px"
                     loading="eager" decoding="async" />
          </figure>
        )}
        <div class="intro__dire">
          <p class="t-label t-quiet code">01 — The line</p>
          <p class="t-lead intro__lead">{c.lead}</p>
        </div>
      </div>
    </section>

    {c.facts.length > 0 && (
      <section class="section specs" data-type="H" data-sol="wash" data-rail-section="SPECIFICATIONS">
        <div class="shell">
          <header class="specs__head">
            <p class="t-label t-quiet code">02 — Specifications</p>
          </header>
          <dl class="index specs__l">
            {c.facts.map((f, n) => (
              <div class="index__l">
                <span class="t-label index__n">{String(n + 1).padStart(2, '0')}</span>
                <dt class="t-h3 index__t">{f.label}</dt>
                <dd class="t-body index__c">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {c.blocks.length > 0 && (
      <section class="section" data-type="E" data-sol="nuit" data-rail-section="DETAIL">
        <div class="shell edito">
          <div class="edito__t">
            <p class="t-label t-quiet code">03 — Detail</p>
          </div>
          <div class="edito__c">
            {c.blocks.map((b) => (
              <div class="bloc">
                <h2 class="t-h2">{b.title}</h2>
                <p class="t-body t-quiet bloc__p mesure">{b.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section ask" data-rail-section="ENQUIRY">
      <div class="shell ask__in">
        <div>
          <p class="t-label t-quiet code">04 — Enquiry</p>
          <p class="t-h1 ask__line">{c.cta}</p>
        </div>
        <div class="actes">
          <a class="act" href={lien('/contact/')}>Contact us</a>
        </div>
      </div>
    </section>

    <section class="section onward" data-type="F" data-sol="wash" data-rail-section={label.toUpperCase()}>
      <nav class="shell" aria-label={`Our other ${label.toLowerCase()}`}>
        <p class="t-label t-quiet code onward__h">Our other {label.toLowerCase()}</p>
        <div class="cartes cartes--3">
          {others.map((o) => (
            <a class="carte" href={lien(`/${folder}/${o.slug}/`)}>
              <h2 class="t-h3">{o.name}</h2>
            </a>
          ))}
        </div>
      </nav>
    </section>
  </article>
</Base>

<style>
  .tete__in { display: grid; gap: 24px; align-items: end; }
  @media (min-width: 900px) {
    .tete__in { grid-template-columns: 8fr 4fr; }
    .tete__sens { justify-self: end; padding-bottom: .6em; }
  }
  .crumb { display: flex; gap: 10px; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tete__h { margin-top: 20px; }

  .intro__in { display: grid; gap: var(--pile) var(--col-gap); align-items: center; }
  .intro__lead { max-width: 44ch; margin-top: 20px; }
  @media (min-width: 900px) {
    .intro__in { grid-template-columns: 620px minmax(0, 1fr); }
  }
  /* Au telephone, la phrase avant la photographie : on lit, puis on regarde. */
  @media (max-width: 899px) {
    .intro__img { order: 2; }
    .intro__dire { order: 1; }
  }

  .specs__head { margin-bottom: var(--pile); }
  .specs__l { margin: -1px 0 0; }

  .bloc { display: grid; gap: 12px; }

  .ask__in { display: grid; gap: var(--pile); align-items: end; }
  @media (min-width: 900px) { .ask__in { grid-template-columns: 7fr 4fr; } }
  .ask__line { margin-top: 18px; max-width: 22ch; }

  .onward__h { margin-bottom: var(--pile); }
</style>

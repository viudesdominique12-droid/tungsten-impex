---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import copy from '../data/copy.json';
import Photo from './Photo.astro';
import { photo } from '../lib/photos.js';

const { product, siblings } = Astro.props;
const c = copy[product.slug] ?? { lead: '', facts: [], blocks: [], cta: '' };

/* Le sens de circulation se lit à la valeur du fond. */
const flow = product.direction === 'out' ? 'out' : 'in';
const folder = flow === 'out' ? 'export' : 'import';
const label = flow === 'out' ? 'Exports' : 'Imports';

/* Les autres lignes de la même direction. Ni précédent ni suivant : l'ordre
   du tableau n'est pas une séquence et rien ne justifie de la présenter
   comme telle au lecteur. */
const others = siblings.filter((sib) => sib.slug !== product.slug);

/* Quatre des quatorze fichiers font moins de 700px de large. Affiches seuls en
   tete de page ils laissent un vide a leur droite ; mis en vis-a-vis du
   chapeau ils composent. Le fichier decide, encore une fois, de sa mise en
   page — pas l'inverse. */
const img = photo(product.photo);
const petite = !!img && img.width <= 700;

/* La page s'ouvre en typographie, comme À propos et Contact : le nom du
   produit ne se pose plus sur la photo. Deux raisons, et la seconde est la
   vraie. D'abord tout le site s'ouvre alors de la même façon. Ensuite le nom
   sur la photo obligeait à une bande de proportion fixe, et c'est cette bande
   qui écrasait la bibliothèque : une source de 400x331 étalée sur 1440, une
   photo en portrait rognée à 19 % de sa hauteur. Le titre parti, l'image
   reprend son format et sa taille réelle. */
---

<Base title={`${product.name} — Tungsten Import Export`} description={c.lead} flow={flow}>
  <article>
    <header class="shell tete">
      <nav class="crumb t-label t-quiet" aria-label="Breadcrumb">
        <a href="/">Tungsten</a>
        <span aria-hidden="true">&middot;</span>
        <a href={`/#${label.toLowerCase()}`}>{label}</a>
      </nav>
      <h1 class="t-display tete__h">{product.name}</h1>
    </header>

    <div class="shell">
      {petite ? (
        <div class="duo">
          <Photo src={product.photo} alt={product.name} eager />
          <p class="intro__lead">{c.lead}</p>
        </div>
      ) : (
        <Photo src={product.photo} alt={product.name} eager />
      )}

      {!petite && <p class="intro__lead">{c.lead}</p>}

      {c.facts.length > 0 && (
        <dl class="facts">
          {c.facts.map((f) => (
            <div>
              <dt class="t-note t-quiet">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {c.blocks.length > 0 && (
        <div class="prose">
          {c.blocks.map((b) => (
            <section>
              <h2 class="prose__h">{b.title}</h2>
              <p>{b.body}</p>
            </section>
          ))}
        </div>
      )}

      <section class="ask">
        <p class="t-h2 ask__line">{c.cta}</p>
        <div class="ask__act">
          <a class="act" href="/contact/">Contact us</a>
        </div>
      </section>

      <nav class="onward" aria-label={`Our other ${label.toLowerCase()}`}>
        <p class="t-label t-quiet onward__h">Our other {label.toLowerCase()}</p>
        <ul class="onward__l">
          {others.map((o) => (
            <li><a href={`/${folder}/${o.slug}/`}><span class="onward__n">{o.name}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</Base>

<style>
  /* --------------------------------------------------------------- tête -- */
  .tete { padding-block: var(--s-section) var(--s-block); }
  .crumb { display: flex; gap: 8px; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tete__h { margin-top: 10px; }
  .duo { display: grid; gap: var(--s-block) var(--col-gap); align-items: start; }
  @media (min-width: 860px) { .duo { grid-template-columns: auto 1fr; } }
  .duo .intro__lead { max-width: 34ch; }

  /* --------------------------------------------------- chapeau et specs --
     Les specifications etaient enfermees dans la colonne de droite d'une
     grille 7/5, soit deux colonnes de 228px : « Passed coffee exports /
     since 2002 » se coupait pour rien. Une feuille de specifications se lit
     en travers de la page. Le chapeau prend sa mesure et les specs courent
     sous lui, sur trois colonnes. */
  /* L'ecart se pose sur le texte, pas sur la figure : un style scope d'Astro
     n'atteint pas le balisage d'un composant enfant, et la marge posee sur la
     figure du composant Photo ne s'appliquait donc a rien — le chapeau collait
     au bas de l'image. */
  .intro__lead { font-size: var(--t-h2); line-height: var(--lh-h2);
                 font-stretch: var(--wd-text); font-weight: var(--w-text);
                 margin: var(--s-section) 0 0; max-width: 34ch; }
  .duo .intro__lead { margin-top: 0; }
  .facts { margin-top: var(--s-band); }
  @media (min-width: 900px) { .facts { grid-template-columns: repeat(3, 1fr); } }

  /* ------------------------------------------------------------ prose --- */
  .prose { display: grid; gap: var(--s-block) var(--col-gap); padding-top: var(--s-band); }
  @media (min-width: 900px) { .prose { grid-template-columns: 1fr 1fr; } }
  .prose__h { font-size: var(--t-h3); line-height: var(--lh-h3);
              font-stretch: var(--wd-text); font-weight: var(--w-display);
              margin-bottom: 6px; }
  .prose p { color: var(--muted); }

  /* -------------------------------------------------------------- ask --- */
  .ask { margin-top: var(--s-band); display: flex; flex-wrap: wrap;
         gap: 20px 44px; align-items: end; justify-content: space-between; }
  .ask__line { margin: 0; max-width: 26ch; }
  .ask__act { display: flex; flex-wrap: wrap; gap: 12px; }

  /* ----------------------------------------------------------- onward --- */
  .onward { margin-top: var(--s-band); margin-bottom: var(--s-band); }
  .onward__h { margin-bottom: var(--s-block); }
  .onward__l { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 760px) {
    .onward__l { grid-template-columns: repeat(3, 1fr);
                 gap: 18px var(--col-gap); }
  }
  .onward a { display: block; text-decoration: none; width: fit-content; }
  .onward__n { font-size: var(--t-h3); line-height: var(--lh-h3);
               font-stretch: var(--wd-text); font-weight: var(--w-display); }
  .onward a:hover .onward__n { text-decoration: underline; text-underline-offset: 5px;
                          text-decoration-thickness: 1px; }
</style>

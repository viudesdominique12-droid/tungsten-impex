---
/* E — editorial deux colonnes, sur wash.

   Quatre affirmations, toutes de source verifiee, et chacune portee a sa
   ligne : les ingenieurs internes valent pour l'equipement, le stockage froid
   pour les medicaments. Les presenter comme valant pour toute la maison serait
   les surestimer.

   Elles etaient auparavant quatre cartes en rang. Une rangee de cartes juste
   apres une grille de cartes, c'etait deux ecrans successifs identiques : la
   forme editoriale les distingue, et le titre collant donne a la section un
   mouvement propre.
*/
import home from '../../data/home.json';
const r = home.reassurance;
---

<section class="section" data-type="E" data-sol="nuit" data-rail-section="WHAT STANDS BEHIND">
  <div class="shell edito">
    <div class="edito__t">
      <p class="t-label t-quiet code">05 — Record</p>
      <h2 class="t-h1 rea__h">{r.titre}</h2>
      <p class="t-note t-quiet rea__c">{r.chapeau}</p>
    </div>

    <div class="index rea__l">
      {r.cartes.map((c, n) => (
        <div class="index__l">
          <span class="t-label index__n">{String(n + 1).padStart(2, '0')}</span>
          <h3 class="t-h3 index__t">{c.titre}</h3>
          <p class="t-body index__c">{c.corps}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rea__h { margin-top: 18px; max-width: 14ch; }
  .rea__c { margin-top: 16px; max-width: 34ch; }
  .rea__l { margin-top: -1px; }
  /* Dans une colonne d'editorial il n'y a pas la place d'un troisieme rang :
     l'intitule et le corps s'empilent, la numerotation reste a gauche. */
  @media (min-width: 900px) {
    .rea__l .index__l { grid-template-columns: 3rem 1fr;
                        grid-template-areas: 'n titre' '. corps'; }
    .rea__l .index__c { max-width: 62ch; margin-top: 8px; }
  }
</style>

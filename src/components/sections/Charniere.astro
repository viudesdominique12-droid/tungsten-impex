---
/* La charniere : les cartons de medicaments palettises. L'image n'aere pas,
   elle annonce — c'est exactement la marchandise de la section qui suit. */
import Photo from '../Photo.astro';
---

<div class="shell hinge">
  <Photo src="img/company/pharma-warehouse.jpg"
         alt="Palletised medicine cartons in the Tungsten store, Addis Ababa"
         caption="Palletised medicine cartons in the Tungsten store, Dembel City Center." />
</div>

<style>
  /* La legende venait mourir a trente-six pixels de la section suivante. */
  .hinge { padding-bottom: var(--s-section); }
</style>

---
/* BROUILLON A FAIRE VALIDER. Les cinq etapes sont l'usage courant du negoce,
   mais aucune n'a ete confirmee par le client : elles figurent toutes dans la
   liste `aConfirmer` de home.json. La numerotation reprend celle du programme
   de formation, qui existe deja sur le site. */
import home from '../../data/home.json';
const p = home.process;
---

<section class="pro" data-ground="wash">
  <div class="shell">
    <header class="pro__head">
      <h2 class="t-h1">{p.titre}</h2>
      <p class="t-note t-quiet">{p.chapeau}</p>
    </header>
    <ol class="pro__l">
      {p.etapes.map((e, n) => (
        <li class="pro__e">
          <span class="t-note t-quiet pro__n">{String(n + 1).padStart(2, '0')}</span>
          <h3 class="t-h3">{e.titre}</h3>
          <p class="t-body t-quiet">{e.corps}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pro { padding-block: var(--s-band); }
  .pro__head { margin-bottom: var(--s-block); }
  .pro__head p { margin-top: 6px; }
  .pro__l { list-style: none; margin: 0; padding: 0;
            display: grid; gap: var(--s-block) var(--col-gap); }
  @media (min-width: 700px)  { .pro__l { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .pro__l { grid-template-columns: repeat(5, 1fr); } }
  .pro__e { display: grid; gap: 8px; align-content: start; }
  .pro__n { display: block; }
</style>

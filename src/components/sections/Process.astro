---
/* H — index a filets, sur nuit.

   BROUILLON A FAIRE VALIDER : les cinq etapes sont l'usage courant du negoce,
   mais aucune n'a ete confirmee par le client. Elles figurent toutes dans la
   liste `aConfirmer` de home.json.

   La forme, elle, est arretee : cinq etapes numerotees ne sont pas des cartes,
   ce sont des lignes. Le filet suffit a les separer, la numerotation mono
   porte l'ordre, et le fond nuit ramene le rythme sombre a la neuvieme
   section.
*/
import home from '../../data/home.json';
const p = home.process;
---

<section class="section" data-type="H" data-sol="wash" data-rail-section="HOW AN ORDER RUNS">
  <div class="shell">
    <header class="pro__head">
      <p class="t-label t-quiet code">06 — Method</p>
      <div class="pro__ligne">
        <h2 class="t-h1">{p.titre}</h2>
        <p class="t-label t-quiet">{p.chapeau}</p>
      </div>
    </header>

    <ol class="index pro__l">
      {p.etapes.map((e, n) => (
        <li class="index__l">
          <span class="t-label index__n">{String(n + 1).padStart(2, '0')}</span>
          <h3 class="t-h2 index__t">{e.titre}</h3>
          <p class="t-body index__c">{e.corps}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pro__head { margin-bottom: var(--pile); }
  .pro__ligne { display: flex; align-items: baseline; justify-content: space-between;
                gap: 20px; flex-wrap: wrap; margin-top: 16px; }
  .pro__l { list-style: none; margin: -1px 0 0; padding: 0; }
</style>

---
/* ---------------------------------------------------------------------------
   LA PLANCHE — les quatorze lignes, en vignettes, d'un seul coup d'oeil.

   POURQUOI ELLE EXISTE. Mesure de l'accueil sur un telephone de 390px a
   densite 3 : 11 764px de defilement, UNE photographie de 293px de haut, soit
   2,49 % de la surface de la page, et un vide de 8 041px — neuf ecrans et
   demi — entre elle et le bas. Le client avait envoye quatorze photographies
   de sa marchandise et disait que « la facon dont tu l'as disposee ne met pas
   en valeur le travail ».

   ET CE N'EST PAS UNE QUESTION DE NOMBRE. La reference qu'il a lui-meme
   nommee — zaziwe-labs — n'a pas plus de photographies que Tungsten : 3,2 %
   de surface contre 2,49 %. Elle les GROUPE. Quatre de ses cinq visuels
   tiennent dans 563px de defilement, soit les deux tiers d'un ecran. Mesure
   sur Tungsten avec le meme instrument : dix-sept pages sur dix-huit ne
   montrent JAMAIS deux photographies dans une meme fenetre de telephone.

   LA RAISON TECHNIQUE, ET C'EST ELLE QUI DECIDE DE LA FORME. A deux colonnes
   sur 390px, une cellule fait 168px CSS, soit 504px sur un ecran a densite
   triple. Mesure des quinze fichiers a cette taille : DOUZE sont parfaitement
   nets, et les trois autres manquent de 1,12x — invisible. Sur la fiche, ces
   memes fichiers manquent de 1,58 a 2,16x. La vignette n'est donc pas un
   pis-aller : c'est la seule taille a laquelle les photographies du client
   sont bonnes. Montrer petit et net vaut mieux que montrer grand et mou.

   CE QU'ELLE NE FAIT PAS. Elle ne rogne pas : chaque cellule prend la
   proportion de son fichier, comme partout ailleurs sur le site. Les rangees
   sont donc inegales, et c'est le prix a payer pour ne pas couper. Elle ne
   double pas non plus les registres : ceux-la se lisent, celle-ci se regarde,
   et chaque vignette mene a sa fiche.

   SUR SOL NUIT, et pour deux raisons. Une photographie detachee sur un fond
   sombre porte plus loin qu'une photographie posee sur du bleute clair. Et la
   regle d'alternance de l'accueil veut une section sombre au moins toutes les
   trois sections : la derniere est la huitieme, celle-ci est la onzieme.
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import { photo } from '../../lib/photos.js';
import { largeurs } from '../../lib/largeurs.js';
import { lien } from '../../lib/lien.js';
import { sortants, entrants } from '../../lib/registre.js';

/* Les sortantes d'abord : c'est le metier d'origine de la maison, et c'est
   l'ordre des deux registres plus haut dans la page. */
const lignes = [...sortants, ...entrants]
  .map((p) => ({ ...p, img: photo(p.photo) }))
  .filter((p) => p.img);

/* L'echelle est calee sur la cellule, pas sur la fenetre : 168px CSS au plus
   etroit, 300px au plus large, donc 504 a 900px d'ecran selon la densite. */
const PALIERS = [200, 340, 520, 700];
---

<section class="section planche" data-type="F" data-sol="nuit" data-rail-section="THE LINES">
  <div class="shell">
    <header class="planche__head">
      <p class="t-label t-quiet code">05 — The lines</p>
      <div class="planche__ligne">
        <h2 class="t-h1">Everything we move</h2>
        <p class="t-label t-quiet">{sortants.length} out, {entrants.length} in</p>
      </div>
    </header>

    <div class="planche__grille">
      {lignes.map((p) => (
        <a class="vign" href={lien(`/${p.folder}/${p.slug}/`)}>
          <div class="vign__img" style={`aspect-ratio: ${p.img.width} / ${p.img.height}`}>
            <Picture src={p.img} alt={p.name} formats={['avif']} fallbackFormat="webp"
                     widths={largeurs(p.img, PALIERS)}
                     sizes="(max-width: 619px) calc(50vw - 27px), (max-width: 999px) calc(33vw - 25px), 240px"
                     loading="lazy" decoding="async" />
          </div>
          <p class="t-label vign__n">{p.name}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .planche__head { margin-bottom: var(--pile); }
  .planche__ligne { display: flex; align-items: baseline; justify-content: space-between;
                    gap: 20px; flex-wrap: wrap; margin-top: 16px; }

  /* Deux colonnes sur telephone, et ce n'est pas un choix d'encombrement :
     c'est la largeur a laquelle les fichiers du client sont nets. Trois puis
     quatre ensuite, parce que la cellule ne doit pas grandir au point de
     redevenir molle — bornee a 300px par `sizes` et par la grille. */
  .planche__grille { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr));
                     align-items: start; }
  @media (min-width: 620px)  { .planche__grille { gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .planche__grille { gap: 22px; grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  .vign { display: grid; gap: 8px; text-decoration: none; color: inherit;
          transition: transform 200ms var(--ease-pipette); }
  .vign:hover { transform: translateY(-3px); }
  .vign:hover .vign__n { color: #8FADF2; }

  /* La cellule prend la proportion de SON fichier : rien n'est rogne, et les
     rangees sont donc inegales. Le fond clair sous l'image sert aux deux
     fichiers detoures sur blanc, qui disparaitraient sur le sol nuit. */
  .vign__img { overflow: hidden; border-radius: 14px; background: var(--surface); }
  .vign__img :global(img) { width: 100%; height: 100%; display: block; object-fit: contain; }

  /* Pas de « Out » / « In » sous chaque vignette : cela ajoutait une seconde
     ligne de legende, donc un decalage supplementaire entre les deux colonnes
     dont les rangees sont deja inegales. Le sens est dit une fois, dans
     l'en-tete de la section, et les sortantes sont rangees en premier. */
  .vign__n { margin: 0; line-height: 1.25; transition: color 160ms var(--ease-pipette); }
</style>

---
/* E — editorial deux colonnes, sur nuit.

   Le titre reste colle en haut de la fenetre pendant que les paragraphes
   defilent en regard. Le mouvement vient de la mise en page, pas d'une
   animation — c'est le seul moyen d'en obtenir sans le fade-up generalise.

   Le fond nuit tombe ici parce que le rythme le demande : la section 1 est
   nuit, les 2 et 3 sont claires, celle-ci est la quatrieme. Une section sombre
   toutes les deux ou trois sections, c'est le levier le plus puissant contre
   l'ennui — et c'est ce que fait le laboratoire de reference.
*/
import home from '../../data/home.json';
const m = home.manifeste;
---

<section class="section" data-type="E" data-sol="nuit" data-rail-section="THE HOUSE">
  <div class="shell edito">
    <div class="edito__t">
      <p class="t-label t-quiet code">02 — The house</p>
      <h2 class="t-h1 man__h">{m.chapeau}</h2>
    </div>
    <div class="edito__c">
      {m.corps.map((p) => <p class="t-lead mesure">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .man__h { margin-top: 18px; max-width: 16ch; }
  .edito__c p:last-child { color: var(--gris); }
</style>

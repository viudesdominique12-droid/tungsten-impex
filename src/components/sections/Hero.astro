---
/* A — le heros, fond nuit.

   Composition asymetrique, alignee a gauche, jamais centree : micro-libelle
   mono, titre, deux pilules, et le tableau de departs en regard.

   Le titre est a --step-4 et non --step-5. La regle du brief est que les deux
   plus grands crans sont reserves a un contenu qui merite cette taille — une
   affirmation, un chiffre. Celui-ci EST une affirmation, mais il en fait deux,
   quatre-vingt-cinq signes : a --step-5 (jusqu'a 6,8rem) il occuperait a lui
   seul plus d'un ecran de haut, et le client reproche precisement au site ses
   « titres demesures qui font semblant d'occuper l'espace ». Le cran au-dessus
   n'existe donc nulle part sur le site, et c'est une decision, pas un oubli.
*/
import Board from '../Board.astro';
import site from '../../data/site.json';
import { manifeste } from '../../lib/registre.js';

const lignes = site.exports.length + site.imports.length;
import { lien } from '../../lib/lien.js';
---

<section class="hero section" data-type="A" data-sol="nuit" data-premier data-rail-section="ADDIS ABABA">
  <div class="shell hero__in">
    <div class="hero__say">
      <p class="t-label t-quiet code">01 — Import &amp; export</p>

      <h1 class="t-display hero__h">
        <span class="line"><span>We export <em class="accent-mot">Ethiopian</em> oilseeds and pulses.</span></span>
        <span class="line"><span>We import medicines, vehicles and materials.</span></span>
      </h1>

      <div class="actes hero__act">
        <a class="act" href={lien('/contact/')}>Contact us</a>
        <a class="act act--line" href="#exports">Exports</a>
      </div>
    </div>

    {/* LE TABLEAU DE DEPARTS, ET SES DEUX PLACES.

        Sur ordinateur il est ici, en regard du titre : c'est la composition
        asymetrique du heros, et le client la trouve juste — « I really like
        the style ». Sur telephone tout s'empile, et il tombait apres les deux
        boutons : une carte qui change de marchandise toutes les secondes et
        demie, accrochee en fin de premier ecran, sans rien avant ni apres a
        quoi se rattacher. « It's looking a little misplaced. »

        Il ne l'etait pas dans le heros, il l'etait dans la PILE. Sous 900px il
        va donc se poser juste avant le registre des Exports — la ou le lecteur
        s'apprete justement a rencontrer les quatorze lignes. Le panneau cesse
        d'etre l'appendice du premier ecran pour devenir l'ouverture du
        catalogue.

        Un seul element, deplace, jamais duplique : deux copies voudraient dire
        deux fois le meme identifiant, et le script du panneau n'en piloterait
        qu'une. Le deplacement se fait dans index.astro, par un script pose au
        point d'arrivee — il s'execute pendant l'analyse du document, donc
        AVANT le premier affichage : rien ne saute a l'ecran. */}
    <div class="hero__board" id="tableau-bureau">
      <div class="tableau" id="tableau">
        <p class="t-label t-quiet code tableau__h">Exports &amp; imports &middot; {lignes} lines</p>
        <Board items={manifeste} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__in { display: grid; gap: var(--pile); align-items: end; }
  .hero__say { display: grid; gap: var(--pile); align-content: start; }
  .hero__h { margin-top: 4px; }
  .hero__act { margin-top: 4px; }
  .tableau__h { margin-bottom: 14px; }

  @media (min-width: 900px) {
    /* Le blanc est compose : la colonne du tableau est plus etroite que celle
       du titre, et l'ensemble est cale a gauche. Une grille 7/5 laisse a
       droite une reserve qui n'est pas un oubli mais une respiration. */
    .hero__in { grid-template-columns: 7fr 5fr; gap: var(--col-gap); align-items: end; }
    .hero__say { gap: clamp(28px, 3vw, 40px); }
  }

  /* Revelation par masque montant, une seule fois, 80ms entre les lignes.
     Jamais d'opacite : elle fabrique un gris qui n'est dans aucune charte. */
  .line { display: block; overflow: hidden; padding-bottom: .06em; }
  .line > span { display: block; transform: translateY(105%);
                 animation: monte 700ms var(--ease-pipette) forwards; }
  .line:nth-child(2) > span { animation-delay: 80ms; }
  @keyframes monte { to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .line > span { transform: none; animation: none; }
  }
</style>

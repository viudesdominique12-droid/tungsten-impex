---
/* Le registre, sous deux formes du repertoire.

   Quatre lignes d'export et dix categories d'import ne sont pas le meme objet,
   et elles ne prennent donc pas la meme forme.

     H — index a filets   pour les quatre exports. Numerotation mono a gauche,
                          nom au centre, description en regard, et le fait
                          releve pour chaque ligne au bout d'un point de
                          conduite. Dense, sans un seul encadre.

     F — grille de cartes pour les dix imports. Fond surface, rayon en goutte,
                          trois pixels de translation au survol.

   Sortir le meme gabarit pour les deux etait une economie de code, jamais une
   decision de mise en page — et c'est exactement ce qui produisait deux ecrans
   successifs identiques.
*/
const { lignes, titre, compte, id, code, forme = 'index', sol, rail } = Astro.props;
import { lien } from '../../lib/lien.js';
---

<section class="reg section" id={id} data-type={forme === 'index' ? 'H' : 'F'} data-sol={sol} data-rail-section={rail ?? titre.toUpperCase()}>
  <div class="shell">
    <header class="reg__head">
      <p class="t-label t-quiet code">{code}</p>
      <div class="reg__ligne">
        <h2 class="t-h1">{titre}</h2>
        <p class="t-label t-quiet">{compte}</p>
      </div>
    </header>

    {forme === 'index' ? (
      <div class="index">
        {lignes.map((p, n) => (
          <a class="index__l" href={lien(`/${p.folder}/${p.slug}/`)}>
            <span class="t-label index__n">{String(n + 1).padStart(2, '0')}</span>
            <h3 class="t-h2 index__t">{p.name}</h3>
            <p class="t-body index__c">{p.lead}</p>
            {p.fact && (
              <p class="index__f conduite t-note">
                <span class="t-label t-quiet">{p.fact.label}</span>
                <span class="conduite__f"></span>
                <b class="conduite__v">{p.fact.value}</b>
              </p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="cartes cartes--3">
        {lignes.map((p) => (
          <a class="carte" href={lien(`/${p.folder}/${p.slug}/`)}>
            <h3 class="t-h3">{p.name}</h3>
            <p class="t-note t-quiet">{p.lead}</p>
            {p.fact && (
              <p class="carte__f conduite t-note">
                <span class="t-label t-quiet">{p.fact.label}</span>
                <span class="conduite__f"></span>
                <b class="conduite__v">{p.fact.value}</b>
              </p>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .reg__head { margin-bottom: var(--pile); }
  /* Le nom et le compte se tiennent sur une ligne, separes par un filet qui
     court entre les deux : c'est le point de conduite du sommaire imprime,
     applique a un en-tete de section. */
  /* L'en-tete ne tire plus de filet sous lui : l'index en tire un au-dessus de
     sa premiere ligne, et les deux se retrouvaient a quarante-quatre pixels
     l'un de l'autre — deux traits paralleles qui ne separent rien. */
  .reg__ligne { display: flex; align-items: baseline; justify-content: space-between;
                gap: 20px; margin-top: 16px; }
  .index { margin-top: -1px; }
  .carte__f { margin-top: 8px; }
</style>

---
/* Un seul composant, deux densites. Quatre lignes d'export se PRESENTENT —
   nom au corps de titre, description en regard. Dix categories d'import
   s'INDEXENT — deux colonnes serrees, un cran en dessous. Quatre choses et
   dix choses ne sont pas le meme objet. */
const { lignes, titre, compte, id, dense = false, flow } = Astro.props;
---

<section class={dense ? 'reg reg--serre' : 'reg'} id={id} data-flow={flow}>
  <div class="shell">
    <header class="reg__head">
      <h2 class="t-h1">{titre}</h2>
      <p class="t-note t-quiet">{compte}</p>
    </header>
    <div class={dense ? 'reg--index' : 'reg--wide'}>
      {lignes.map((p) => (
        <a class="ent" href={`/${p.folder}/${p.slug}/`}>
          <h3 class={dense ? 't-h3 ent__n' : 't-h2 ent__n'}>{p.name}</h3>
          <p class={dense ? 't-body ent__d' : 't-lead ent__d'}>{p.lead}</p>
          {p.fact && (
            <p class="ent__f">
              <span class="t-note t-quiet">{p.fact.label}</span>
              <b class="t-body">{p.fact.value}</b>
            </p>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .reg { padding-block: 0 var(--s-section); }
  .reg--serre { padding-block: var(--s-band); }
  /* L'en-tete etait compose « nom a gauche, compte a 1200px a droite », et ces
     deux bouts ne tenaient ensemble que par le filet qui les reliait. Empiles
     sur l'axe de gauche, ils tiennent seuls. */
  .reg__head { margin-bottom: var(--s-block); }
  .reg__head p { margin-top: 6px; }

  /* L'index des dix imports faisait 3 202px sur un telephone — un quart de la
     page, deux fois et demie le registre des exports. Dix descriptions
     empilees en une colonne font un mur. Sur un ecran etroit un index sert a
     choisir et a toucher : le nom et le chiffre suffisent, la description est
     sur la fiche, a un doigt. Elle revient des qu'il y a deux colonnes. */
  @media (max-width: 899px) {
    .reg--serre .ent__d { display: none; }
  }
</style>

---
/* La barre d'action, au doigt seulement.

   Sur un telephone, l'action n'etait atteignable qu'en haut de page ; sur une
   page de douze mille pixels, cela veut dire remonter douze mille pixels. Deux
   actions, jamais plus : appeler, ecrire. Elle n'apparait qu'apres le premier
   ecran — celui-ci porte deja ses propres boutons — et se retire quand le pied
   de page entre en vue, ou tout se retrouve.

   Bureau : rien. Un pointeur fin n'a pas besoin qu'on lui apporte le numero.
*/
import site from '../data/site.json';
const c = site.company;
---

<div class="barre" id="barre" data-sol="nuit" hidden>
  <a class="act barre__a" href={`tel:${c.phoneHref}`}>Call</a>
  <a class="act act--line barre__a" href="/contact/">Contact us</a>
</div>

<script is:inline>
  (() => {
    const b = document.getElementById('barre');
    if (!b || !matchMedia('(pointer: coarse)').matches) return;
    const pied = document.querySelector('.ftr');
    let passeHero = false, piedVu = false;
    const rendre = () => { b.hidden = !(passeHero && !piedVu); };

    const hero = document.querySelector('[data-premier]') || document.querySelector('main > *');

    /* L'etat se calcule tout de suite, il ne s'attend pas. Le premier verdict
       d'un IntersectionObserver arrive apres coup, et sur un balisage qui vient
       d'etre insere il peut se prononcer avant la mise en page : la barre
       apparaissait une fraction de seconde par-dessus le premier ecran. */
    const visible = (el) => {
      if (!el) return false;
      const r = el.getBoundingClientRect();
      return r.top < innerHeight && r.bottom > 0;
    };
    passeHero = !visible(hero);
    piedVu = visible(pied);
    rendre();

    if (hero) new IntersectionObserver(([e]) => { passeHero = !e.isIntersecting; rendre(); },
      { rootMargin: '0px' }).observe(hero);
    if (pied) new IntersectionObserver(([e]) => { piedVu = e.isIntersecting; rendre(); },
      { rootMargin: '0px' }).observe(pied);
  })();
</script>

<style>
  .barre {
    position: fixed; inset: auto 0 0 0; z-index: 80;
    padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom));
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    border-top: 1px solid rgba(234, 241, 250, .14);
  }
  /* `display: grid` sur `.barre` a la meme specificite que le
     `[hidden] { display: none }` de la feuille du navigateur, et l'emporte sur
     lui parce qu'il vient de l'auteur. L'attribut que le script pose et retire
     n'a longtemps rien cache : la barre etait affichee sur toutes les pages,
     en permanence, y compris par-dessus le premier ecran et par-dessus le pied
     de page — exactement les deux cas que ce script evite. */
  .barre[hidden] { display: none; }
  .barre__a { width: 100%; min-height: 50px; padding-inline: 12px; }
  @media (pointer: fine) { .barre { display: none; } }
</style>

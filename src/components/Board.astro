---
/* ---------------------------------------------------------------------------
   Le tableau de départs.

   Le premier écran était vide à droite du titre. On ne remplit pas un vide
   avec de la décoration : un cube qui tourne, un champ de particules ou une
   forme WebGL sont la signature la plus reconnaissable d'une page générée, et
   ils ne disent rien de la maison. Ce qui bouge ici, c'est le métier lui-même.

   Quatorze marchandises réelles défilent, une par une, avec leur direction et
   leur chiffre. Le panneau bascule sur l'axe X, comme un tableau à volets —
   la langue visuelle native du fret — et il CHANGE DE FOND avec la direction :
   lavis d'encre quand la marchandise sort, aplat bleu quand elle entre. Le
   système de couleur du site s'explique donc tout seul, en trois secondes,
   avant même qu'on ait défilé — et depuis que la section Imports est passée
   au lavis, cette face bleue est le seul aplat soutenu de l'accueil.

   Les deux faces sont écrites par Astro, et le script ne remplace que du
   texte. Écrire le HTML depuis le script paraissait plus court, mais les
   styles d'un composant Astro sont portés par un attribut de portée que le
   balisage injecté n'a pas : dès la première bascule, la ligne de fait
   ressortait en « ProductEthiopian white Humera sesame seed », sans grille ni
   hiérarchie. Le balisage vient donc du serveur, une fois, et ne bouge plus.

   Poids : aucune bibliothèque, deux transformations CSS, une trentaine de
   lignes de script. Le panneau est un lien vers la fiche affichée ; sans
   mouvement demandé, il ne tourne pas du tout et montre la première ligne.
   --------------------------------------------------------------------------- */
const { items } = Astro.props;
const faces = [items[0], items[1] ?? items[0]];
---

<div class="board" id="board">
  <a class="board__card" id="board-card" href={items[0].href} data-dir={items[0].flow}>
    {faces.map((it, n) => (
      <span class:list={['board__face', n === 1 && 'board__face--b']}
            data-ground={it.flow === 'in' ? 'blue' : undefined}>
        <span class="t-note board__dir">{it.dir}</span>
        <span class="t-h1 board__n">{it.name}</span>
        <span class="board__f" hidden={!it.factLabel}>
          <span class="t-note t-quiet board__fl">{it.factLabel}</span>
          <b class="t-body board__fv">{it.factValue}</b>
        </span>
      </span>
    ))}
  </a>
</div>

<script is:inline define:vars={{ items }}>
  (() => {
    const board = document.getElementById('board');
    const card = document.getElementById('board-card');
    if (!board || !card || items.length < 2) return;

    const faces = [...card.querySelectorAll('.board__face')].map((el) => ({
      el,
      dir: el.querySelector('.board__dir'),
      nom: el.querySelector('.board__n'),
      bloc: el.querySelector('.board__f'),
      etiq: el.querySelector('.board__fl'),
      val: el.querySelector('.board__fv'),
    }));

    /* On ne remplace que du texte : le balisage et sa portée de style restent
       ceux qu'Astro a écrits. */
    const peindre = (f, it) => {
      // La face entrante garde l'aplat bleu plein : c'est le seul accent fort
      // de l'accueil depuis que la section Imports est passee au lavis, et
      // c'est l'echelle a laquelle la reference emploie sa couleur.
      if (it.flow === 'in') f.el.dataset.ground = 'blue';
      else delete f.el.dataset.ground;
      f.dir.textContent = it.dir;
      f.nom.textContent = it.name;
      f.etiq.textContent = it.factLabel || '';
      f.val.textContent = it.factValue || '';
      f.bloc.hidden = !it.factLabel;
    };

    /* Le survol N'ARRETE PAS la rotation, il la repousse.

       La premiere version arretait tout sur pointerenter. Le panneau occupe le
       centre du premier ecran — c'est exactement la qu'on pose sa souris — et
       un curseur simplement gare le figeait indefiniment : il avait l'air
       casse. Reproduit a l'essai : curseur dessus, gele ; curseur ailleurs,
       tourne.

       Mais on ne peut pas non plus le laisser tourner sous le curseur : on
       cliquerait sur autre chose que ce qu'on lit. Le compromis est le
       mouvement, pas la presence. Tant que le pointeur BOUGE sur le panneau,
       la bascule est repoussee ; des qu'il s'immobilise, elle reprend. Un
       lecteur actif le tient ; un curseur oublie ne le tue pas. Le delai de
       repousse reste plus long que la cadence : sous le curseur on veut lire,
       pas compter les bascules. */
    const CADENCE = 1500, PREMIERE = 1000, REPOUSSE = 1800;
    let i = 0, tour = 0, t = null, gele = false, jusqua = 0;
    const calme = matchMedia('(prefers-reduced-motion: reduce)');

    const tourner = () => {
      i = (i + 1) % items.length;
      tour += 180;
      peindre(faces[tour % 360 === 180 ? 1 : 0], items[i]);
      card.style.transform = `rotateX(${tour}deg)`;
      card.dataset.dir = items[i].flow;
      card.setAttribute('href', items[i].href);
    };

    const battre = () => {
      // La boucle meurt d'elle-meme si le panneau quitte le document : c'est ce
      // qui evite qu'une maquette a page unique en accumule une par visite.
      if (!card.isConnected || calme.matches) return;
      const reste = jusqua - Date.now();
      if (gele || reste > 0) { t = setTimeout(battre, gele ? 400 : reste); return; }
      tourner();
      t = setTimeout(battre, CADENCE);
    };

    const repousser = () => { jusqua = Date.now() + REPOUSSE; };
    board.addEventListener('pointermove', repousser);

    // Au clavier, en revanche, on arrete franchement : on ne lit pas une cible
    // qui se derobe.
    card.addEventListener('focus', () => { gele = true; });
    card.addEventListener('blur', () => { gele = false; });
    document.addEventListener('visibilitychange', () => { gele = document.hidden; });

    /* L'inclinaison suit le pointeur : c'est ce qui donne au panneau une
       épaisseur plutôt qu'une animation plaquée. Elle est portée par le
       conteneur, pas par la carte, sinon elle entrerait en conflit avec la
       bascule. Cinq degrés au maximum : au-delà, c'est un gadget. */
    if (!calme.matches && matchMedia('(hover: hover)').matches) {
      board.addEventListener('pointermove', (e) => {
        const r = board.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        board.style.setProperty('--ty', `${(-y * 5).toFixed(2)}deg`);
        board.style.setProperty('--tx', `${(x * 5).toFixed(2)}deg`);
      });
      board.addEventListener('pointerleave', () => {
        board.style.setProperty('--ty', '0deg');
        board.style.setProperty('--tx', '0deg');
      });
    }

    // La premiere bascule vient plus tot que les suivantes : qui arrive sur la
    // page doit voir le panneau bouger avant de decider qu'il est fixe.
    if (!calme.matches) t = setTimeout(battre, PREMIERE);
  })();
</script>

<style>
  .board { perspective: 1400px; --ty: 0deg; --tx: 0deg; }
  .board__card {
    display: block; position: relative; height: 260px;
    transform-style: preserve-3d; text-decoration: none;
    transform: rotateX(var(--ty)) rotateY(var(--tx));
    transition: transform var(--turn) var(--ease-in-out);
  }
  .board__face {
    position: absolute; inset: 0; backface-visibility: hidden;
    display: grid; align-content: space-between;
    padding: 24px 26px; overflow: hidden;
  }
  /* La face sortante n'avait aucun fond : le panneau disparaissait sur les
     exports et ne revenait qu'en bleu — un clignotement, pas une bascule. Elle
     prend un lavis d'encre, dérivé par opacité comme tous les gris du site.
     L'attribut ne vit que sur les faces : posé sur la carte, `[data-flow='in']`
     peignait la carte entière et redéfinissait --hair pour ses deux faces. */
  .board__face:not([data-ground]) { background: rgba(10, 27, 60, .07); }
  .board__face--b { transform: rotateX(180deg); }

  .board__dir { display: block; }
  .board__n { display: block; align-self: center; text-wrap: balance; }
  .board__f { display: grid; gap: 2px; }
  .board__fv { font-weight: var(--w-text); }

  @media (max-width: 899px) {
    .board__card { height: 220px; }
    .board__face { padding: 20px 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .board__card { transition: none; }
  }
</style>

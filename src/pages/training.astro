---
/* Formation, au repertoire :

     A  tete sur nuit, avec le chapeau
     D  bande photo pleine largeur
     H  index a filets : les sept modules, numerotes
        le formulaire, sur nuit, champs en surface
*/
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import Photo from '../components/Photo.astro';

const c = site.company;
const t = site.training;
---

<Base
  title="Book to train with us — Tungsten Import Export"
  description="Practical import and export training in Addis Ababa: export procedure and documentation, quality assurance, negotiation, cross-border contracts, risk and foreign market access."
  rail="TRAINING"
>
  <section class="tete section" data-type="A" data-sol="nuit" data-premier data-rail-section="TRAINING">
    <div class="shell tete__in">
      <div>
        <p class="t-label t-quiet code">01 — Training</p>
        <h1 class="t-display tete__h">Book to <em class="accent-mot">train</em> with us</h1>
      </div>
      <p class="t-lead tete__p mesure">{t.intro}</p>
    </div>
  </section>

  {/* Pas de bande pleine largeur ici. Le fichier fait 720px de large : etale
      sur une fenetre de 1440 il serait agrandi deux fois, trois fois sur un
      ecran de 1920 — et six fois sur un ecran a densite double. La regle du
      site borne l'agrandissement a 1,4x, et sous 1024px de source il n'y a
      pas de bande du tout. La photographie garde donc sa colonne, a sa taille
      reelle. C'est la seule page du site qui n'a pas de type D. */}
  <div class="shell portrait" data-rail-section="AT WORK">
    <Photo src="img/company/team-desk.jpg" eager
           alt="A member of the Tungsten team at work"
           caption="A member of the Tungsten team at work." />
  </div>

  <section class="section" data-type="H" data-rail-section="THE PROGRAMME">
    <div class="shell">
      <header class="syl__head">
        <p class="t-label t-quiet code">02 — The programme</p>
        <div class="syl__ligne">
          <h2 class="t-h1">What the programme covers</h2>
          <p class="t-label t-quiet">{t.modules.length} modules</p>
        </div>
      </header>
      <ol class="index syl__list">
        {t.modules.map((m, n) => (
          <li class="index__l">
            <span class="t-label index__n">{String(n + 1).padStart(2, '0')}</span>
            <span class="t-h2 index__t">{m}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section form-wrap" data-sol="wash" data-rail-section="ENROL">
    <div class="shell">
      <header class="form__head">
        <p class="t-label t-quiet code">03 — Enrol</p>
        <h2 class="t-h1 form__h">Tell us how to reach you</h2>
      </header>

      <form class="form" id="enrol" data-email={c.email} novalidate>
        <div class="row">
          <p class="t-label t-quiet">Who you are</p>
          <div class="pair">
            <p class="f"><label for="n">Full name <span class="req">*</span></label>
              <input id="n" name="name" type="text" autocomplete="name" required /></p>
            <p class="f"><label for="e">Email <span class="req">*</span></label>
              <input id="e" name="email" type="email" autocomplete="email" required /></p>
            <p class="f"><label for="p">Phone <span class="req">*</span></label>
              <input id="p" name="phone" type="tel" autocomplete="tel" placeholder="+251 …" required /></p>
            <p class="f"><label for="l">City and country</label>
              <input id="l" name="location" type="text" placeholder="Addis Ababa, Ethiopia" /></p>
          </div>
        </div>

        <div class="row">
          <p class="t-label t-quiet">When you would like to begin</p>
          <div class="pair">
            <p class="f"><label for="s">Preferred start</label>
              <input id="s" name="start" type="month" />
              <small class="hint">Leave blank if you can start whenever a place opens.</small></p>
            <p class="f"><label for="x">Experience so far</label>
              <select id="x" name="experience">
                <option value="">Prefer not to say</option>
                <option>Complete beginner</option>
                <option>Some exposure to trade</option>
                <option>Already trading</option>
              </select></p>
          </div>
        </div>

        <div class="row">
          <p class="t-label t-quiet">Anything else</p>
          <p class="f"><label for="m">Message</label>
            <textarea id="m" name="message" placeholder="Optional — what you hope to get out of the training."></textarea></p>
        </div>

        <div class="row">
          <p class="t-label t-quiet">Send</p>
          <div>
            <button class="act" type="submit">Send my enquiry</button>
            <p class="note">{t.note}</p>
            <p class="note">Office hours: {c.hours.weekdays}.</p>
            <p class="status t-body" id="status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .tete__in { display: grid; gap: var(--pile) var(--col-gap); align-items: end; }
  @media (min-width: 900px) { .tete__in { grid-template-columns: 6fr 5fr; } }
  .tete__h { margin-top: 22px; }
  .tete__p { color: var(--gris); }

  .portrait { padding-top: var(--pad-section-mob); }
  @media (min-width: 900px) { .portrait { padding-top: var(--pad-section); } }

  .syl__head { margin-bottom: var(--pile); }
  .syl__ligne { display: flex; align-items: baseline; justify-content: space-between;
                gap: 20px; flex-wrap: wrap; margin-top: 16px; }
  .syl__list { list-style: none; margin: -1px 0 0; padding: 0; }

  /* Le formulaire etait sur nuit. Avec la tete et le pied, la page passait a
     74 % de sombre — un fond, plus un rythme. Il prend le lavis, et les champs
     s'y detachent en surface au lieu de s'y creuser. */
  .form__head { margin-bottom: var(--pile); }
  .form__h { margin-top: 18px; }
  .form { display: grid; gap: var(--pile); }
  .row { display: grid; gap: 14px var(--col-gap);
         padding-top: 22px; border-top: 1px solid var(--filet); }
  @media (min-width: 780px) { .row { grid-template-columns: 220px 1fr; } }
  .row > p:first-child { margin: 0; padding-top: .35em; }

  .pair { display: grid; gap: 16px; }
  @media (min-width: 760px) { .pair { grid-template-columns: 1fr 1fr; } }
  .f { display: grid; gap: 8px; margin: 0; }
  .f label { font-family: var(--font-mono); font-size: var(--label);
             letter-spacing: .12em; text-transform: uppercase; color: var(--gris); }
  .req { color: var(--encre); }
  /* Un bloc empli plutot qu'une boite cerclee : six contours alignes, c'est
     encore du trait. Le fond dit ou l'on ecrit ; il suffit. Le coin en goutte
     signe le champ comme il signe la carte. */
  .f input, .f select, .f textarea {
    font-family: var(--font-body); font-size: var(--step-0); color: var(--encre);
    background: var(--surface); border: 0;
    border-radius: var(--goutte-carte);
    padding: 14px 16px; width: 100%; }
  .f textarea { resize: vertical; min-height: 120px; }
  .f input::placeholder, .f textarea::placeholder { color: var(--gris); }
  .f input:focus, .f select:focus, .f textarea:focus {
    outline: 2px solid currentColor; outline-offset: 0; }
  .f select option { color: #0A1A33; }
  .hint { font-family: var(--font-mono); font-size: var(--label);
          letter-spacing: .06em; color: var(--gris); }

  .note { margin-top: 14px; color: var(--gris); font-family: var(--font-mono);
          font-size: var(--label); line-height: 1.6; letter-spacing: .04em; }
  .status { margin-top: 12px; }
  .form .act { width: auto; }
</style>

<script>
  const form = document.getElementById('enrol');
  const status = document.getElementById('status');
  form.addEventListener('submit', (e) => {
    /* On retient l'envoi AVANT de valider. Ecrit dans l'autre ordre, un
       formulaire incomplet sortait du gestionnaire sans que rien n'ait
       empeche l'envoi natif : le navigateur rechargeait la page, et les
       reponses deja saisies passaient en clair dans la barre d'adresse. */
    e.preventDefault();
    if (!form.reportValidity()) return;
    const d = new FormData(form);
    const g = (k) => (d.get(k) || '').toString().trim();
    const body = [
      'Training enquiry — Tungsten Import Export', '',
      'Name:            ' + g('name'),
      'Email:           ' + g('email'),
      'Phone:           ' + g('phone'),
      'City / country:  ' + g('location'),
      'Preferred start: ' + (g('start') || 'as soon as a place opens'),
      'Experience:      ' + (g('experience') || 'not specified'),
      '', 'Message:', g('message') || '—',
    ].join('\n');
    window.location.href = 'mailto:' + form.dataset.email +
      '?subject=' + encodeURIComponent('Training enquiry — ' + (g('name') || 'new student')) +
      '&body=' + encodeURIComponent(body);
    status.textContent = 'Your email app is opening with the enquiry ready to send. If nothing happens, write to ' + form.dataset.email + '.';
  });
</script>

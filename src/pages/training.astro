---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import Photo from '../components/Photo.astro';
const c = site.company;
const t = site.training;
---

<Base
  title="Book to train with us — Tungsten Import Export"
  description="Practical import and export training in Addis Ababa: export procedure and documentation, quality assurance, negotiation, cross-border contracts, risk and foreign market access."
>
  <section class="top">
    <div class="shell">
      <p class="t-label t-quiet">Training</p>
      <h1 class="t-h1 top__h">Book to train with us</h1>
    </div>
  </section>

  {/* La photo est un portrait de 720x1280 : tenue a la verticale, elle ne
      peut pas faire une banniere. Elle se met en vis-a-vis du chapeau. */}
  <div class="shell duo">
    <Photo src="img/company/team-desk.jpg" eager
           alt="A member of the Tungsten team at work" />
    <p class="top__p">{t.intro}</p>
  </div>

  {/* Le programme reel, tel que fourni par l entreprise. */}
  <section class="syl">
    <div class="shell">
      <h2 class="t-h2 syl__h">What the programme covers</h2>
      <ol class="syl__list">
        {t.modules.map((m, n) => (
          <li>
            <span class="t-label t-quiet syl__n">{String(n + 1).padStart(2, '0')}</span>
            <span class="syl__m">{m}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="form-wrap">
    <div class="shell">
      <h2 class="t-h2 form__h">Tell us how to reach you</h2>
      <form class="form" id="enrol" data-email={c.email} novalidate>
        <div class="row">
          <p class="t-label t-quiet">Who you are</p>
          <div class="pair">
            <p class="f"><label for="n">Full name <span class="req">*</span></label>
              <input id="n" name="name" type="text" autocomplete="name" required /></p>
            <p class="f"><label for="e">Email <span class="req">*</span></label>
              <input id="e" name="email" type="email" autocomplete="email" required /></p>
            <p class="f"><label for="p">Phone <span class="req">*</span></label>
              <input id="p" name="phone" type="tel" autocomplete="tel" placeholder="+251 …" required /></p>
            <p class="f"><label for="l">City and country</label>
              <input id="l" name="location" type="text" placeholder="Addis Ababa, Ethiopia" /></p>
          </div>
        </div>

        <div class="row">
          <p class="t-label t-quiet">When you would like to begin</p>
          <div class="pair">
            <p class="f"><label for="s">Preferred start</label>
              <input id="s" name="start" type="month" />
              <small class="hint">Leave blank if you can start whenever a place opens.</small></p>
            <p class="f"><label for="x">Experience so far</label>
              <select id="x" name="experience">
                <option value="">Prefer not to say</option>
                <option>Complete beginner</option>
                <option>Some exposure to trade</option>
                <option>Already trading</option>
              </select></p>
          </div>
        </div>

        <div class="row">
          <p class="t-label t-quiet">Anything else</p>
          <p class="f"><label for="m">Message</label>
            <textarea id="m" name="message" placeholder="Optional — what you hope to get out of the training."></textarea></p>
        </div>

        <div class="row">
          <p class="t-label t-quiet">Send</p>
          <div>
            <button class="act" type="submit">Send my enquiry</button>
            <p class="note">{t.note}</p>
            <p class="note">Office hours: {c.hours.weekdays}.</p>
            <p class="status" id="status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .top { padding-block: clamp(30px, 4.5vw, 62px) clamp(22px, 3vw, 40px); }
  .top__h { margin-top: 12px; }
  .top__p { margin-top: 18px; font-size: clamp(1.1rem, 1.7vw, 1.35rem); line-height: 1.5; }
  .duo { display: grid; gap: var(--s-block) var(--col-gap);
         align-items: start; margin-bottom: var(--s-section); }
  @media (min-width: 860px) { .duo { grid-template-columns: auto 1fr; } }
  .duo .top__p { max-width: 42ch; }

  .syl__h { margin-bottom: 20px; }
  .syl__list { list-style: none; margin: 0 0 clamp(40px, 5.5vw, 76px); padding: 0;
               border-top: 1px solid var(--rule); }
  .syl__list li { display: grid; gap: 4px 28px; align-items: baseline;
                  padding-block: clamp(16px, 2.2vw, 26px);
                  border-bottom: 1px solid var(--rule); }
  @media (min-width: 620px) { .syl__list li { grid-template-columns: 60px 1fr; } }
  .syl__n { margin: 0; }
  .syl__m { font-stretch: 106%; font-weight: 720; font-size: clamp(1.05rem, 1.6vw, 1.3rem);
            letter-spacing: -.012em; }

  .form__h { margin-bottom: 18px; }
  .form { border-top: 1px solid var(--rule); }
  .row { display: grid; gap: 10px 32px; padding-block: clamp(20px, 3vw, 32px);
         border-bottom: 1px solid var(--rule); }
  @media (min-width: 780px) { .row { grid-template-columns: 220px 1fr; } }
  .row > p:first-child { margin: 0; max-width: none; }

  .pair { display: grid; gap: 16px; }
  @media (min-width: 620px) { .pair { grid-template-columns: 1fr 1fr; } }
  .f { display: grid; gap: 6px; margin: 0; max-width: none; }
  .f label { font-stretch: 66%; font-weight: 620; font-size: .88rem; color: var(--muted); }
  .req { color: var(--fg); }
  .f input, .f select, .f textarea {
    font-family: inherit; font-size: 1rem; color: var(--fg);
    background: transparent; border: 1px solid var(--rule); border-radius: 0;
    padding: 12px 14px; width: 100%; }
  .f textarea { resize: vertical; min-height: 110px; }
  .f input:focus, .f select:focus, .f textarea:focus { outline: 0; border-color: var(--fg); }
  .hint { font-size: .82rem; color: var(--muted); }

  .note { margin-top: 12px; color: var(--muted); font-size: .92rem; }
  .status { margin-top: 8px; font-weight: 500; }
</style>

<script>
  const form = document.getElementById('enrol');
  const status = document.getElementById('status');
  form.addEventListener('submit', (e) => {
    if (!form.reportValidity()) return;
    e.preventDefault();
    const d = new FormData(form);
    const g = (k) => (d.get(k) || '').toString().trim();
    const body = [
      'Training enquiry — Tungsten Import Export', '',
      'Name:            ' + g('name'),
      'Email:           ' + g('email'),
      'Phone:           ' + g('phone'),
      'City / country:  ' + g('location'),
      'Preferred start: ' + (g('start') || 'as soon as a place opens'),
      'Experience:      ' + (g('experience') || 'not specified'),
      '', 'Message:', g('message') || '—',
    ].join('\n');
    window.location.href = 'mailto:' + form.dataset.email +
      '?subject=' + encodeURIComponent('Training enquiry — ' + (g('name') || 'new student')) +
      '&body=' + encodeURIComponent(body);
    status.textContent = 'Your email app is opening with the enquiry ready to send. If nothing happens, write to ' + form.dataset.email + '.';
  });
</script>

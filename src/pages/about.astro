---
/* A propos, au repertoire :

     A  tete sur nuit
     D  bande photo pleine largeur, le plateau de bureaux
     E  editorial : la lettre du fondateur, titre collant
     H  index a filets sur nuit : les cinq registres
        les locaux, photo et texte en vis-a-vis
*/
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import Photo from '../components/Photo.astro';
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos.js';

const c = site.company;
const plateau = photo('img/company/office-floor.jpg');
const largeurs = [640, 1024, 1440, 1920].filter((w) => w <= (plateau?.width ?? 0));

const registres = [
  'EPOSPEA',
  'Ethiopian Chamber of Commerce',
  'Ministry of Revenue',
  'National Bank of Ethiopia',
  'Ministry of Trade',
];
---

<Base
  title="About us — Tungsten Import Export"
  description="Founded in 2007 in Addis Ababa to bridge local potential with global markets. Words from the founder, and the premises we work from."
  rail="ABOUT US"
>
  <section class="tete section" data-sol="nuit" data-premier data-rail-section="ABOUT US">
    <div class="shell">
      <p class="t-label t-quiet code">01 — About us</p>
      <h1 class="t-display tete__h">
        Naturally strong. Built to <em class="accent-mot">endure</em>.
      </h1>
    </div>
  </section>

  {plateau && (
    <figure class="pleine" data-rail-section="THE PREMISES">
      <Picture src={plateau} alt="The Tungsten office floor" formats={['avif']}
               fallbackFormat="webp" widths={largeurs.length ? largeurs : [plateau.width]}
               sizes="100vw" loading="eager" decoding="async" />
      <figcaption>
        <span class="shell t-label">The office floor on the 4th floor of Dembel City Center.</span>
      </figcaption>
    </figure>
  )}

  <section class="section letter" data-rail-section="FROM THE FOUNDER">
    <div class="shell edito">
      <div class="edito__t">
        <p class="t-label t-quiet code">02 — From the founder</p>
        <Photo src="img/company/founder.jpg" class="letter__img"
               alt="At the Tungsten office in Addis Ababa" />
      </div>
      <div class="edito__c">
        {site.founder.paragraphs.map((t, n) => (
          <p class={n === 0 ? 't-lead mesure' : 't-body t-quiet mesure'}>{t}</p>
        ))}
        <p class="letter__sign">
          <b class="t-h3">{site.founder.name}</b>
          <span class="t-label t-quiet">{site.founder.role} &middot; {c.name}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section" data-sol="wash" data-rail-section="REGISTERED WITH">
    <div class="shell">
      <header class="memb__head">
        <p class="t-label t-quiet code">03 — On record</p>
        <h2 class="t-h1 memb__h">Registered with</h2>
      </header>
      <ol class="index memb__list">
        {registres.map((m, n) => (
          <li class="index__l">
            <span class="t-label index__n">{String(n + 1).padStart(2, '0')}</span>
            <span class="t-h2 index__t">{m}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Le texte parle d'une zone de quarantaine ; la photographie en montrait
      une autre. Elle montre maintenant celle-la. */}
  <section class="section premises" data-rail-section="AFRICA AVENUE">
    <div class="shell premises__in">
      <Photo src="img/company/quarantine.jpg"
             alt="The quarantine area on the 4th floor of Dembel City Center"
             caption="The quarantine area." />
      <div>
        <p class="t-label t-quiet code">04 — Where we work</p>
        <h2 class="t-h1 premises__h">Africa Avenue, Addis Ababa</h2>
        <p class="t-lead premises__p">Offices, a licensed pharmaceutical store and a quarantine area, on the 4th floor of Dembel City Center.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .tete__h { margin-top: 22px; max-width: 16ch; }

  .letter__img { margin-top: 26px; }
  .letter__img img { border-radius: var(--goutte-carte); }
  .letter__sign { display: grid; gap: 6px; margin-top: 12px; }

  .memb__head { margin-bottom: var(--pile); }
  .memb__h { margin-top: 18px; }
  .memb__list { list-style: none; margin: -1px 0 0; padding: 0; }

  .premises__in { display: grid; gap: var(--pile) var(--col-gap); align-items: start; }
  @media (min-width: 860px) { .premises__in { grid-template-columns: 5fr 6fr; } }
  .premises__h { margin-top: 18px; }
  .premises__p { margin-top: 20px; max-width: 40ch; color: var(--gris); }
</style>

---
import ProductSheet from '../../components/ProductSheet.astro';
import site from '../../data/site.json';

export function getStaticPaths() {
  return site.imports.map((p) => ({
    params: { slug: p.slug },
    props: { product: p, siblings: site.imports },
  }));
}
---
<ProductSheet product={Astro.props.product} siblings={Astro.props.siblings} />

---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import copy from '../data/copy.json';
import Photo from '../components/Photo.astro';

/* Le fait porte en colonne de droite est designe nommement dans copy.json
   (cle "mark"). L'heuristique precedente — le plus court qui contient un
   chiffre — remontait le numero de telephone pour trois lignes et repetait
   "More than 20 years" a l'identique sur deux autres. Un registre dont la
   colonne de droite melange des specifications et un numero de standard se
   lit comme une sortie de machine. Le choix est editorial. */
const pick = (slug) => {
  const e = copy[slug];
  return e?.facts?.find((f) => f.label === e.mark) ?? null;
};
const row = (p, folder) => ({ ...p, folder, lead: copy[p.slug]?.lead ?? '', fact: pick(p.slug) });

const out = site.exports.map((p) => row(p, 'export'));
const inn = site.imports.map((p) => row(p, 'import'));
const c = site.company;
---

<Base
  title="Tungsten Import Export — Addis Ababa"
  description="We export Ethiopian oilseeds and pulses, and import medicines, vehicles and materials into Ethiopia. Trading from Addis Ababa since 2007."
>
  {/* 1 — PREMIER ECRAN. Le titre, et rien dessous : ni bouton, ni chapeau.
        La premiere ligne du registre affleure, ce qui dit qu'il y a un
        document sous le titre. */}
  <section class="hero">
    <div class="shell">
      <h1 class="t-display hero__h">
        <span class="line"><span>We export Ethiopian oilseeds and pulses.</span></span>
        <span class="line"><span>We import medicines, vehicles and materials.</span></span>
      </h1>
    </div>
  </section>

  {/* 2 — REGISTRE SORTANT, sur le papier. */}
  <section class="reg-out" id="exports">
    <div class="shell">
      <header class="reg__head">
        <h2 class="t-h2">Exports</h2>
        <p class="t-note t-quiet">{out.length} products</p>
      </header>
      <div class="reg">
        {out.map((p) => (
          <a class="row" href={`/${p.folder}/${p.slug}/`}>
            <span class="t-h3 row__n">{p.name}</span>
            <span class="t-body row__d">{p.lead}</span>
            {p.fact && (
              <span class="row__f">
                <span class="t-body row__v">{p.fact.value}</span>
                <span class="t-label t-quiet">{p.fact.label}</span>
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* La charniere. Une seule image sur l'accueil, et c'est la marchandise :
        les legumineuses triees par variete, vues de dessus. Sa grille rime
        avec le registre qu'elle referme. Quatorze vignettes de produits
        auraient fait une grille de cartes — ce qu'on cherche a eviter. */}
  <div class="shell">
    <Photo src="img/company/contact.jpg" alt="Pulses and oilseeds sorted by variety" />
  </div>

  {/* 3 — REGISTRE ENTRANT, meme composant, sur la nuit. La page descend du
        papier vers la nuit : c'est le sens de circulation, litteralement. */}
  <section class="reg-in" id="imports" data-flow="in">
    <div class="shell">
      <header class="reg__head">
        <h2 class="t-h2">Imports</h2>
        <p class="t-note t-quiet">{inn.length} categories</p>
      </header>
      <div class="reg">
        {inn.map((p) => (
          <a class="row" href={`/${p.folder}/${p.slug}/`}>
            <span class="t-h3 row__n">{p.name}</span>
            <span class="t-body row__d">{p.lead}</span>
            {p.fact && (
              <span class="row__f">
                <span class="t-body row__v">{p.fact.value}</span>
                <span class="t-label t-quiet">{p.fact.label}</span>
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 4 — CLOTURE. Il y avait ici une bande de chiffres cles : 2007 et 30,
        composes au palier d'affichage. C'est la figure la plus usee du
        gabarit d'entreprise, et j'etais deja passe de quatre chiffres a deux
        pour la meme raison — le bout de ce raisonnement est zero. Les deux
        durees vivent la ou elles ont un sens : 2007 est imprime dans le
        bandeau de tete de chaque page, les trente annees du fondateur sont
        dans sa lettre, a un lien d'ici. */}
  <section class="orient">
    <div class="shell g g--d">
      <div>
        <p class="t-lead orient__addr">
          {c.address.line1}<br />{c.address.line2}<br />{c.address.city}, {c.address.country}
        </p>
        <p class="t-body t-quiet orient__h">{c.hours.weekdays}</p>
      </div>
      <div class="orient__links">
        <a class="t-h2" href="/about/">Read the founder&rsquo;s letter</a>
        <a class="t-h2" href="/contact/">Contact us</a>
        <a class="t-h2" href="/training/">Book to train with us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- 1. premier ecran --- */
  .hero { padding-block: var(--s-section) var(--s-section); }
  .hero__h { display: grid; gap: 0; }
  /* Revelation par masque, jamais de fondu : l'opacite fabrique un gris qui
     n'est dans aucune charte. */
  .line { display: block; overflow: hidden; padding-bottom: .04em; }
  .line > span { display: block; transform: translateY(100%);
                 animation: rise var(--in) var(--ease-out) forwards; }
  .line:nth-child(2) > span { animation-delay: 30ms; }
  @keyframes rise { to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .line > span { transform: none; animation: none; }
  }

  /* --- 2 et 3. les deux registres, un seul gabarit --- */
  .reg-out { padding-block: 0 var(--s-band); }
  .reg-in  { padding-block: var(--s-section); }
    .reg__head { display: flex; align-items: baseline; justify-content: space-between;
               gap: var(--col-gap); padding-bottom: 14px;
               border-bottom: 2px solid var(--fg); margin-bottom: var(--s-block); }


  /* --- 4. cloture --- */
  .orient { padding-block: var(--s-band); }
  .orient__h { margin-top: 16px; }
  .orient__links { display: grid; gap: 16px; align-content: start; }
  .orient__links a { text-decoration: none; border-bottom: 1px solid var(--rule);
                     padding-bottom: 8px; width: fit-content;
                     transition: border-color var(--hover) linear; }
  .orient__links a:hover { border-bottom-color: var(--fg); }
</style>

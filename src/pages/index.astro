---
/* ---------------------------------------------------------------------------
   L'accueil n'est plus une page, c'est une suite de sections nommees.

   Constat : la page comptait cinq blocs — titre, Exports, photo, Imports,
   adresse. Un catalogue avec une banniere. Les sites du studio en comptent dix
   a douze, et chacun a un role : dire ce qu'on est, montrer ce qu'on vend,
   prouver qu'on tient, expliquer comment on travaille, repondre aux questions
   qui viennent avant l'achat, et appeler.

   Il manquait donc le manifeste, la reassurance, le process, la FAQ et l'appel
   final. Ils sont la. Le process et une partie de la FAQ sont des brouillons a
   faire confirmer par le client : la liste des affirmations concernees est
   dans src/data/home.json, cle `aConfirmer`.
   --------------------------------------------------------------------------- */
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Manifeste from '../components/sections/Manifeste.astro';
import Registre from '../components/sections/Registre.astro';
import Charniere from '../components/sections/Charniere.astro';
import Reassurance from '../components/sections/Reassurance.astro';
import Process from '../components/sections/Process.astro';
import Faq from '../components/sections/Faq.astro';
import AppelFinal from '../components/sections/AppelFinal.astro';
import { sortants, entrants } from '../lib/registre.js';
---

<Base
  title="Tungsten Import Export — Addis Ababa"
  description="We export Ethiopian oilseeds and pulses, and import medicines, vehicles and materials into Ethiopia. Trading from Addis Ababa since 2007."
>
  <Hero />
  <Manifeste />

  <Registre lignes={sortants} titre="Exports" compte={`${sortants.length} products`} id="exports" />
  <Charniere />
  <Registre lignes={entrants} titre="Imports" compte={`${entrants.length} categories`}
            id="imports" dense flow="in" />

  <Reassurance />
  <Process />
  <Faq />
  <AppelFinal />
</Base>

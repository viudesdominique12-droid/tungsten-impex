---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import copy from '../data/copy.json';

/* §6 — la colonne de droite reprend un fait DÉJÀ présent dans la copie.
   On retient le plus court : c'est celui qui se compose en grand sans
   déformer la ligne. Rien n'est inventé, rien n'est reformulé. */
const pick = (slug) => {
  const f = copy[slug]?.facts;
  if (!f?.length) return null;
  const withNum = f.filter((x) => /\d/.test(x.value));
  const pool = withNum.length ? withNum : f;
  return [...pool].sort((a, b) => a.value.length - b.value.length)[0];
};

const rows = (list, folder) =>
  list.map((p) => ({ ...p, folder, lead: copy[p.slug]?.lead ?? '', fact: pick(p.slug) }));

const outRows = rows(site.exports, 'export');
const inRows = rows(site.imports, 'import');

/* §5 — une bande pleine largeur par page, deux au maximum. */
const band = site.exports.find((p) => p.wide) ?? site.exports[0];
---

<Base
  title="Tungsten Import Export — Addis Ababa"
  description="Ethiopian oilseeds and pulses to international buyers; equipment and materials into Ethiopia, cleared and delivered. Trading from Addis Ababa since 2007."
>
  {/* -------------------------------------------------------- héros §7 --- */}
  <section class="hero">
    <div class="shell">
      <p class="hero__meta t-label t-quiet reveal" style="--i:0">
        Tungsten Import Export &middot; Addis Ababa, Ethiopia &middot; Established {site.company.founded}
      </p>

      {/* Deux temps : la sortie affirmée, l'entrée en gris. La hiérarchie se
          fait par la valeur, pas par la taille. */}
      <h1 class="t-hero hero__title">
        <span class="reveal" style="--i:1">Ethiopian oilseeds and pulses out.</span>
        <span class="reveal t-quiet" style="--i:2">Medicines, vehicles and materials in.</span>
      </h1>

      <div class="hero__act reveal" style="--i:3">
        <button type="button" class="pill" id="go-out" data-go="out">What we export</button>
        <button type="button" class="pill pill--line" id="go-in" data-go="in">What we import</button>
      </div>
    </div>
  </section>

  {/* ------------------------------------------- bande de chiffres §8 ---- */}
  <section class="figures" data-flow="in">
    <div class="shell figures__in">
      <div>
        <p class="t-num">{site.imports.length}</p>
        <p class="t-label t-quiet">Lines brought into Ethiopia</p>
      </div>
      <div>
        <p class="t-num">{site.company.founded}</p>
        <p class="t-label t-quiet">Trading from Addis Ababa</p>
      </div>
      <div>
        <p class="t-num">30</p>
        <p class="t-label t-quiet">Years in Ethiopian oilseeds and pulses</p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ liste §6 ----------- */}
  <section class="list">
    <div class="shell">
      <h2 class="t-section list__h" data-when="out">What we export</h2>
      <h2 class="t-section list__h" data-when="in">What we import</h2>

      <div class="rows" data-when="out">
        {outRows.map((p) => (
          <a class="row" href={`/${p.folder}/${p.slug}/`}>
            <span class="t-cat row__n">{p.name}</span>
            <span class="row__d t-quiet">{p.lead}</span>
            {p.fact && (
              <span class="row__f">
                <span class={p.fact.value.length > 16 ? 'row__v row__v--long' : 'row__v'}>{p.fact.value}</span>
                <span class="t-label t-quiet">{p.fact.label}</span>
              </span>
            )}
          </a>
        ))}
      </div>

      <div class="rows" data-when="in">
        {inRows.map((p) => (
          <a class="row" href={`/${p.folder}/${p.slug}/`}>
            <span class="t-cat row__n">{p.name}</span>
            <span class="row__d t-quiet">{p.lead}</span>
            {p.fact && (
              <span class="row__f">
                <span class={p.fact.value.length > 16 ? 'row__v row__v--long' : 'row__v'}>{p.fact.value}</span>
                <span class="t-label t-quiet">{p.fact.label}</span>
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* §5 — bande pleine largeur, bord à bord. Respiration entre deux blocs. */}
  <figure class="media media--band band">
    <img src={`/${band.photo}`} alt="" loading="lazy" />
  </figure>

  {/* ------------------------------------------------------- fondateur --- */}
  <section class="founder">
    <div class="shell founder__in">
      <div>
        <p class="t-label t-quiet">From the founder</p>
        <p class="founder__q">{site.founder.paragraphs[0]}</p>
        <a class="pill pill--line" href="/about/">Read the full letter</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(36px, 6vw, 82px) clamp(28px, 4vw, 52px); }
  .hero__meta { margin: 0 0 clamp(18px, 2.5vw, 30px); max-width: none; }
  .hero__title { display: grid; gap: .06em; }
  .hero__act { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(24px, 3.5vw, 40px); }

  /* §8 — bande pleine largeur sur l'encre, filet fin au-dessus de chaque colonne. */
  .figures { background: var(--ink); color: var(--paper); }
  .figures__in { display: grid; gap: 26px 40px; padding-block: clamp(30px, 4vw, 54px); }
  @media (min-width: 700px) { .figures__in { grid-template-columns: repeat(3, 1fr); } }
  .figures__in > div { border-top: 1px solid var(--rule); padding-top: 14px; }
  .figures__in p { margin: 0; max-width: none; }
  .figures__in .t-label { margin-top: 8px; }

  /* §6 — rythme de liste. Filet seul, aucun fond, aucun rayon, aucune ombre. */
  .list { padding-top: clamp(40px, 5.5vw, 78px); }
  .list__h { margin-bottom: clamp(20px, 3vw, 34px); }
  .rows { border-top: 1px solid var(--rule); }

  .row {
    display: grid; gap: 8px 32px; align-items: baseline;
    padding-block: clamp(28px, 4vw, 52px);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  @media (min-width: 760px) { .row { grid-template-columns: 1.1fr 1.6fr auto; } }

  .row__n { margin: 0; }
  .row__d { margin: 0; font-size: 1rem; line-height: 1.5; max-width: 62ch; }

  .row__f { display: grid; gap: 4px; justify-items: start; }
  @media (min-width: 760px) { .row__f { justify-items: end; text-align: right; } }
  .row__v {
    font-stretch: 116%; font-weight: 800; font-variant-numeric: tabular-nums;
    font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1; letter-spacing: -.025em;
    border-bottom: 2px solid transparent; transition: border-color .2s var(--swing);
  }
  /* Un fait long ne peut pas se composer au corps d'un chiffre : on le réduit
     plutôt que de le tronquer ou de le reformuler (§0 — textes intouchables). */
  .row__v--long { font-stretch: 100%; font-weight: 720; font-size: 1.05rem;
                  line-height: 1.35; max-width: 22ch; }

  /* §6 — au survol, le fait passe en noug. Sur fond CLAIR noug ne donne que
     1,99 en texte : il devient donc un soulignement, ce que le §3 autorise.
     Sur fond sombre (7,85) il colore le texte. */
  .row:hover .row__v { border-bottom-color: var(--noug); }
  [data-flow='in'] .row:hover .row__v { color: var(--noug); border-bottom-color: transparent; }

  /* §5 — bande pleine largeur, bord à bord. */
  .band { margin: clamp(40px, 5.5vw, 78px) 0 0; }

  .founder { padding-top: clamp(40px, 5.5vw, 78px); }
  .founder__q { font-size: clamp(1.15rem, 1.9vw, 1.5rem); line-height: 1.45;
                margin: 12px 0 24px; max-width: 60ch; }

  /* --------------------------------------------------------- bascule --- */
  [data-when] { display: none; }
  :global(body[data-flow='out']) [data-when='out'],
  :global(body[data-flow='in']) [data-when='in'] { display: block; }

  /* §9 — une seule séquence, au chargement : les lignes montent sous masque. */
  .reveal { display: block; animation: rise 700ms var(--swing) both;
            animation-delay: calc(var(--i) * 80ms); }
  @keyframes rise {
    from { opacity: 0; transform: translateY(.5em); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .reveal { animation: none; } }
</style>

<script>
  // La bascule est une classe sur <body> : le fond change de valeur, la liste
  // suit. §8 du brief precedent, §3 de celui-ci.
  const body = document.body;
  const pills = document.querySelectorAll('.pill[data-go]');

  const apply = (go) => {
    body.dataset.flow = go;
    pills.forEach((p) => {
      const on = p.dataset.go === go;
      p.classList.toggle('pill--line', !on);
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', go === 'in' ? '#1a1d18' : '#f7f5f0');
  };

  const wanted = new URLSearchParams(location.search).get('flow');
  if (wanted === 'in' || wanted === 'out') apply(wanted);

  pills.forEach((p) =>
    p.addEventListener('click', () => {
      if (body.dataset.flow !== p.dataset.go) apply(p.dataset.go);
    })
  );
</script>

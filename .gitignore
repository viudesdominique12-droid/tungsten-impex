# --- verif/ : seule la suite nommee est suivie -------------------------------
# Les agents d'audit ecrivent leurs sondes dans verif/ — il faut y etre pour
# importer playwright — et les suppriment ensuite. Entre les deux, un
# « git add -A » les ramasse : c'est arrive trois fois de suite. Le dossier est
# donc ferme par defaut, et chaque fichier de la suite est nomme.
verif/*
!verif/bureau-tranches.mjs
!verif/cadence.mjs
!verif/check.mjs
